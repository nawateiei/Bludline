local function renderModeTags()
    local tags = ModeRadar.tags
    local count = 0
    if S.bl_mode_en and JutsuRadar.order then
        local order = JutsuRadar.order
        local roots = JutsuRadar.roots
        local near = JutsuRadar.near
        local maxTags = #tags
        local modeSize = S.bl_mode_size or 13
        local lp = Players.LocalPlayer
        local myName = lp and lp.Name

        local maxDist = S.bl_combat_dist or 400
        for i = 1, #order do
            if count >= maxTags then break end
            local pn = order[i]
            local d = near[pn]
            if not d or d > maxDist then break end
            local isSelf = (myName and pn == myName) or (lp and pn == lp.Name)
            if isSelf and not S.bl_mode_self then
                -- skip self
            else
                local root = roots[pn]
                if root then
                    local entry = ModeRadar.cache[pn]
                    if not entry or (rNow - (ModeRadar.cacheAt[pn] or 0)) > 15 then
                        local rsSettings = JutsuRadar.rsSettingsCache or game:GetService("ReplicatedStorage"):FindFirstChild("Settings")
                        local f = rsSettings and rsSettings:FindFirstChild(pn)
                        entry = {
                            awk = f and f:FindFirstChild("Awakened"),
                            cd  = f and f:FindFirstChild("AwakeningCooldown"),
                        }
                        ModeRadar.cache[pn] = entry
                        ModeRadar.cacheAt[pn] = rNow
                    end

                    local awkVal = ""
                    local cdVal = 0
                    if entry.awk then
                        local okA, a = pcall(getValue, entry.awk)
                        if okA and type(a) == "string" then awkVal = a end
                    end
                    if entry.cd then
                        local okC, c = pcall(getValue, entry.cd)
                        if okC and type(c) == "number" then cdVal = c end
                    end

                    local label, col
                    if awkVal ~= "" then
                        -- Mode is active!
                        local modeName = getCleanModeName(awkVal)
                        if S.bl_mode_dur and cdVal > 0 then
                            local secLeft = math.ceil(cdVal)
                            if S.bl_mode_name then
                                label = "[" .. modeName .. ": " .. tostring(secLeft) .. "s]"
                            else
                                label = "[MODE: " .. tostring(secLeft) .. "s]"
                            end
                        elseif S.bl_mode_name then
                            label = "[" .. modeName .. "]"
                        end
                        col = Color3.fromRGB(205, 80, 255)
                    elseif S.bl_mode_cd and cdVal > 0 then
                        -- Mode is on cooldown!
                        local secLeft = math.ceil(cdVal)
                        label = "[MODE CD: " .. tostring(secLeft) .. "s]"
                        col = Color3.fromRGB(255, 140, 40)
                    end

                    if label then
                        local okP, rPos = pcall(getPosOf, root)
                        if okP and isValidVec3(rPos) then
                            local okS, sp, onScreen = pcall(WorldToScreen, rPos)
                            if okS and onScreen and isValidVec2(sp) then
                                local dist = (rCamPos - rPos).Magnitude
                                local rawH = (5.5 / (max(dist, 1) * rTan)) * rVpH
                                if isValidNum(rawH) then
                                    local h = clamp(floor(rawH), 16, 450)
                                    count = count + 1
                                    local t = tags[count]

                                    if t.text ~= label then
                                        t.tag.Text = label
                                        t.text = label
                                    end
                                    if t.col ~= col then
                                        t.tag.Color = col
                                        t.col = col
                                    end
                                    if t.size ~= modeSize then
                                        t.tag.Size = modeSize
                                        t.size = modeSize
                                    end

                                    local curOff = tagOffsets[pn] or 20
                                    local modeStep = math.floor(modeSize + 6)
                                    tagOffsets[pn] = curOff + modeStep
                                    local x, y = floor(sp.X), floor(sp.Y - floor(h * 0.5) - curOff)
                                    if t.x ~= x or t.y ~= y then
                                        t.x = x; t.y = y
                                        t.tag.Position = Vector2.new(x, y)
                                    end
                                    if not t.vis then
                                        t.tag.Visible = true
                                        t.vis = true
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    hideModeTags(count + 1)
end

-- ---------------- HIDE EVERYTHING (camera lost / render error) ----------------
local function hideAllDrawings()
    for i = 1, MOB_POOL_SIZE do local s = mobPool[i]; s.isShown = true; hideMobSlot(s) end
    for i = 1, CORRUPT_POOL_SIZE do local s = corruptPool[i]; s.isShown = true; hideCorruptSlot(s) end
    for i = 1, RIFT_POOL_SIZE do local s = riftPool[i]; s.isShown = true; hideRiftSlot(s) end
    for i = 1, NPC_POOL_SIZE do local s = npcPool[i]; s.isShown = true; hideNPCSlot(s) end
    for i = 1, ITEM_POOL_SIZE do local s = itemPool[i]; s.isShown = true; hideItemSlot(s) end
    setHud(csHudTitle, false)
    setHud(csHudContent, false)
    hideEventSlot()
    hideJutsuTags(1)
    hideSubTags(1)
    hideIFrameTags(1)
    hideModeTags(1)
end

local function renderFrame()
    local cam = Workspace.CurrentCamera
    local camPos = cam and cam.Position
    local viewport = cam and cam.ViewportSize

    -- No usable camera (loading screen / respawn / minimized): clear the screen instead of
    -- leaving the last frame's boxes frozen on it.
    if not (camPos and isValidVec3(camPos) and viewport and viewport.X > 20 and viewport.Y > 20) then
        hideAllDrawings()
        return
    end

    local tanHalfFov2 = math.tan(math.rad(cam.FieldOfView or 70) * 0.5) * 2.0
    if not isValidNum(tanHalfFov2) or tanHalfFov2 <= 0.001 then
        hideAllDrawings()
        return
    end

    rCamPos = camPos
    rVpH    = viewport.Y
    rTan    = tanHalfFov2
    rBotX   = floor(viewport.X * 0.5)
    rBotY   = floor(viewport.Y)

    -- Fast-travel flush (>100 studs in one frame)
    if lastCamPos and (camPos - lastCamPos).Magnitude > 100.0 then
        scanEpoch = scanEpoch + 1
        trackedMobs, trackedCorrupt, trackedRifts, trackedNPCs, trackedItems = {}, {}, {}, {}, {}
        mobCands = {}
        drawDirty = true
    end
    lastCamPos = camPos

    if drawDirty or lastDrawSettingsVersion ~= settingsVersion then
        rebuildDrawLists()
    end

    _G.Bloodline_DebugState = {
        trackedMobs = #trackedMobs,
        trackedCorrupt = #trackedCorrupt,
        trackedRifts = #trackedRifts,
        trackedNPCs = #trackedNPCs,
        trackedItems = #trackedItems,
        drawMobs = #drawMobs,
        drawItems = #drawItems,
        scanEpoch = scanEpoch,
    }

    renderMobs()
    renderCorrupt()
    renderRifts()
    renderNPCs()
    renderItems()
    renderChakraHud()
    renderBeastTamer()
    tagOffsets = {}
    -- Isolated: an error in any combat assist tag can never blank the ESP
    local okJ, errJ = pcall(renderJutsuTags)
    if not okJ then logDebug("Jutsu tag render error: " .. tostring(errJ)) end
    local okSub, errSub = pcall(renderSubTags)
    if not okSub then logDebug("Sub tag render error: " .. tostring(errSub)) end
    local okInv, errInv = pcall(renderIFrameTags)
    if not okInv then logDebug("IFrame tag render error: " .. tostring(errInv)) end
    local okMode, errMode = pcall(renderModeTags)
    if not okMode then logDebug("Mode tag render error: " .. tostring(errMode)) end
end

_G.Bloodline_renderConn = RunService.RenderStepped:Connect(function()
    if not alive() then return end

    -- Frame limiter: 15% tolerance below the cap so it follows your display refresh rate
    local now = os.clock()
    if (now - lastRenderClock) < MIN_FRAME_TIME then return end
    lastRenderClock = now
    rNow = now

    _G.Bloodline_renderFrameCount = _G.Bloodline_renderFrameCount + 1

    if now - lastSettingsPoll >= SETTINGS_POLL then
        lastSettingsPoll = now
        pcall(refreshSettings)
    end

    local ok, err = pcall(renderFrame)
    if not ok then
        _G.Bloodline_lastError = tostring(err)
        logDebug("RenderStepped error: " .. tostring(err))
        pcall(hideAllDrawings)
    end
end)

