                            if okS and onScreen and isValidVec2(sp) then
                                local dist = (rCamPos - rPos).Magnitude
                                local rawH = (5.5 / (max(dist, 1) * rTan)) * rVpH
                                if isValidNum(rawH) then
                                    local h = clamp(floor(rawH), 16, 450)
                                    count = count + 1
                                    local t = tags[count]

                                    if t.text ~= label then
                                        t.tag.Text = label
                                        t.text = label
                                    end
                                    if t.col ~= col then
                                        t.tag.Color = col
                                        t.col = col
                                    end
                                    if t.size ~= modeSize then
                                        t.tag.Size = modeSize
                                        t.size = modeSize
                                    end

                                    local curOff = tagOffsets[pn] or 20
                                    local modeStep = math.floor(modeSize + 6)
                                    tagOffsets[pn] = curOff + modeStep
                                    local x, y = floor(sp.X), floor(sp.Y - floor(h * 0.5) - curOff)
                                    if t.x ~= x or t.y ~= y then
                                        t.x = x; t.y = y
                                        t.tag.Position = Vector2.new(x, y)
                                    end
                                    if not t.vis then
                                        t.tag.Visible = true
                                        t.vis = true
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    hideModeTags(count + 1)
end

