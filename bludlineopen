-- Track info cache. Resolving an AnimationTrack's id costs ~10 memory reads; the id of a given
-- track never changes, so we resolve it once and afterwards only re-validate with ONE read
-- (the Animation pointer) in case the memory slot got reused by a different track.
local trackCache = {}
local trackCacheCount = 0

local function resolveTrack(track)
    local animPtr = ReadPointer(track + MemoryOffsets.Animation)
    local info = trackCache[track]
    if info and info.animPtr == animPtr then
        return info
    end

    if trackCacheCount > 400 then
        trackCache = {}
        trackCacheCount = 0
    end

    info = { animPtr = animPtr, valid = false, ignored = true, animId = "N/A", numId = "N/A" }
    if GetClassName(track) == "AnimationTrack" then
        local animId = GetIdFromTrack(track)
        local numId = animId:match("%d+") or animId
        info.valid   = true
        info.animId  = animId
        info.numId   = numId
        info.ignored = (IGNORED_ANIMATIONS[numId] or IGNORED_ANIMATIONS[animId]) and true or false
    end

    if not trackCache[track] then trackCacheCount = trackCacheCount + 1 end
    trackCache[track] = info
    return info
end

-- hum = the target's Humanoid (already known by the collector), aux = per-target cache table
local function GetPlayingAnimationTracks(hum, aux)
    local tracks = {}
    if not hum then return tracks end

    local animator = aux.animator
    if not animator then
        local now = os.clock()
        if (now - (aux.animLookupAt or 0)) < 1 then return tracks end
        aux.animLookupAt = now
        animator = hum:FindFirstChildOfClass("Animator")
        aux.animator = animator
        if not animator then return tracks end
    end

    local animAddr = animator.Address
    if not animAddr then
        aux.animator = nil
        return tracks
    end

    local listHead = ReadPointer(animAddr + MemoryOffsets.ActiveAnimations)
    if not listHead then return tracks end

    local currentNode = ReadPointer(listHead)
    local safetyCap = 0

    while currentNode and currentNode ~= 0 and currentNode ~= listHead and safetyCap < 15 do
        safetyCap = safetyCap + 1
        local track = ReadPointer(currentNode + MemoryOffsets.NodeNext)
        if track then
            local info = resolveTrack(track)
            if info.valid and not info.ignored then
                local okTime, timePos = pcall(memory_read, "float", track + MemoryOffsets.TimePosition)
                tracks[#tracks + 1] = {
                    track   = track,
                    animId  = info.animId,
                    numId   = info.numId,
                    timePos = okTime and timePos or 0
                }
            end
        end
        currentNode = ReadPointer(currentNode)
    end
    return tracks
end

-- IEEE-754 Validation Helpers
local function isValidNum(n)
    return type(n) == "number" and n == n and n > -1e9 and n < 1e9
end

local function isValidVec2(v)
    return v and isValidNum(v.X) and isValidNum(v.Y)
end

local function isValidVec3(v)
    return v and isValidNum(v.X) and isValidNum(v.Y) and isValidNum(v.Z)
end

