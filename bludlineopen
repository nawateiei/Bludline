local function getClickedLeaderboardPlayer(mx, my)
    local cam = Workspace.CurrentCamera
    local vp = cam and cam.ViewportSize
    if vp and mx < (vp.X - 350) then return nil end

    local lp = Players.LocalPlayer
    local pListGui = lp and lp:FindFirstChild("PlayerGui") and lp.PlayerGui:FindFirstChild("ClientGui")
    local mf = pListGui and pListGui:FindFirstChild("Mainframe")
    local plFrame = mf and mf:FindFirstChild("PlayerList")
    if not plFrame then return nil end
    local list = plFrame:FindFirstChild("List")
    if not list then return nil end

    local templates = {}
    for _, c in ipairs(list:GetChildren()) do
        if c.Name:find("PlayerTemplate") and c.AbsolutePosition then
            local pos = c.AbsolutePosition
            local sz = c.AbsoluteSize
            local w = (sz and sz.X > 0) and sz.X or 300
            local h = (sz and sz.Y > 0) and sz.Y or 28
            table.insert(templates, {
                btn = c,
                minX = pos.X - 15,
                maxX = pos.X + w + 15,
                minY = pos.Y - 4,
                maxY = pos.Y + h + 4,
                y = pos.Y
            })
        end
    end
    if #templates == 0 then return nil end
    table.sort(templates, function(a, b) return a.y < b.y end)

    local allPlayers = Players:GetPlayers()
    for idx, t in ipairs(templates) do
        if mx >= t.minX and mx <= t.maxX and my >= t.minY and my <= t.maxY then
            local pNameObj = t.btn:FindFirstChild("PlayerName")
            local charName = pNameObj and pNameObj.Text
            local matched = nil
            if charName and charName ~= "" and charName ~= "failed to fetch text" then
                local cn = charName:lower()
                for _, p in ipairs(allPlayers) do
                    local pn = p.Name:lower()
                    if pn == cn or pn:find(cn, 1, true) or cn:find(pn, 1, true) then
                        matched = p
                        break
                    end
                end
            end
            if not matched and #allPlayers > 0 then
                matched = allPlayers[((idx - 1) % #allPlayers) + 1]
            end
            if matched then
                return matched, charName
            end
        end
    end
    return nil
end

local function handleLeftClick(mx, my)
    local nowClick = os.clock()
    if (nowClick - BX.lastClickAt) < 0.2 then return false end
    BX.lastClickAt = nowClick
    -- If JDUI menu is open, let user interact with JDUI without triggering inspector
    if ui and ui.IsOpen and ui:IsOpen() then return false end

    -- 1. Check if clicking on Card Close [X] button
    if cardVisible then
        if mx >= (cardScreenPos.X + CARD_W - 85) and mx <= (cardScreenPos.X + CARD_W + 10)
           and my >= cardScreenPos.Y and my <= (cardScreenPos.Y + 30) then
            hideProfileCard()
            return true
        end
    end

    -- 2. Check if clicking on Leaderboard Player
    if S.bl_inspect_en ~= false then
        local p, cName = getClickedLeaderboardPlayer(mx, my)
        if p then
            if cardVisible and inspectedPlayer == p then
                -- Clicked on the same player again: toggle closed!
                hideProfileCard()
                return true
            else
                showProfileCard(p, cName)
                return true
            end
        end
    end

    -- 3. If card is visible and clicking outside of card, close card ("unsee it by clicking off")
    if cardVisible then
        if mx < (cardScreenPos.X - 10) or mx > (cardScreenPos.X + CARD_W + 10)
           or my < (cardScreenPos.Y - 10) or my > (cardScreenPos.Y + CARD_H + 10) then
            hideProfileCard()
            return true
        end
    end
    return false
end

local function handleXKey()
    if cardVisible then hideProfileCard() end
end

-- Fallback native event connection via UserInputService
if _G.Bloodline_inputConn then
    pcall(function() _G.Bloodline_inputConn:Disconnect() end)
    _G.Bloodline_inputConn = nil
end
_G.Bloodline_inputConn = UserInputService.InputBegan:Connect(function(input)
    local itype = input.UserInputType
    if itype == Enum.UserInputType.MouseButton1 then
        local lp = Players.LocalPlayer
        local mouse = lp and lp:GetMouse()
        local mx = (input.Position and input.Position.X) or (mouse and mouse.X) or 0
        local my = (input.Position and input.Position.Y) or (mouse and mouse.Y) or 0
        pcall(handleLeftClick, mx, my)
    elseif itype == Enum.UserInputType.Keyboard then
        if input.KeyCode == Enum.KeyCode.X then
            pcall(handleXKey)
        end
    end
end)

cycleInspectPlayer = function(delta)
    local all = Players:GetPlayers()
    if #all == 0 then return end
    local curIdx = 1
    if inspectedPlayer then
        for i, p in ipairs(all) do
            if p == inspectedPlayer then curIdx = i; break end
        end
    end
    local nextIdx = ((curIdx - 1 + delta) % #all) + 1
    showProfileCard(all[nextIdx])
end

-- ---------------- HIDE EVERYTHING (camera lost / render error) ----------------
local function hideAllDrawings()
    for i = 1, MOB_POOL_SIZE do local s = mobPool[i]; s.isShown = true; hideMobSlot(s) end
    for i = 1, CORRUPT_POOL_SIZE do local s = corruptPool[i]; s.isShown = true; hideCorruptSlot(s) end
    for i = 1, RIFT_POOL_SIZE do local s = riftPool[i]; s.isShown = true; hideRiftSlot(s) end
    for i = 1, NPC_POOL_SIZE do local s = npcPool[i]; s.isShown = true; hideNPCSlot(s) end
    for i = 1, ITEM_POOL_SIZE do local s = itemPool[i]; s.isShown = true; hideItemSlot(s) end
    setHud(csHudTitle, false)
    setHud(csHudContent, false)
    hideEventSlot()
    hideJutsuTags(1)
    hideSubTags(1)
    hideIFrameTags(1)
    hideModeTags(1)
    hideStunTags(1)
    hideProfileCard()
end

local function renderFrame()
    local cam = Workspace.CurrentCamera
    local camPos = cam and cam.Position
    local viewport = cam and cam.ViewportSize

    -- No usable camera (loading screen / respawn / minimized): clear the screen instead of
    -- leaving the last frame's boxes frozen on it.
    if not (camPos and isValidVec3(camPos) and viewport and viewport.X > 20 and viewport.Y > 20) then
        hideAllDrawings()
        return
    end

    local tanHalfFov2 = math.tan(math.rad(cam.FieldOfView or 70) * 0.5) * 2.0
    if not isValidNum(tanHalfFov2) or tanHalfFov2 <= 0.001 then
        hideAllDrawings()
        return
    end

    BX.reads = 0
    BX.posCache = {}
    if (rNow - BX.pruneAt) > 30 then
        BX.pruneAt = rNow
        for k, r in pairs(BX.vals) do
            if (rNow - r.at) > 20 then BX.vals[k] = nil end
        end
    end
    rCamPos = camPos
    rVpH    = viewport.Y
    rTan    = tanHalfFov2
    rBotX   = floor(viewport.X * 0.5)
    rBotY   = floor(viewport.Y)

    -- Fast-travel flush (camera or character jumped > 75 studs)
    local lpChar = Players.LocalPlayer and Players.LocalPlayer.Character
    local lpRoot = lpChar and (lpChar:FindFirstChild("HumanoidRootPart") or lpChar:FindFirstChild("Torso"))
    local myPos = lpRoot and lpRoot.Position
    local camTeleported = lastCamPos and (camPos - lastCamPos).Magnitude > 75.0
    local charTeleported = lastMyPos and myPos and (myPos - lastMyPos).Magnitude > 75.0

    if (camTeleported or charTeleported) and (rNow - (BX.lastTeleportFlush or 0)) > 2.0 then
        BX.lastTeleportFlush = rNow
        scanEpoch = scanEpoch + 1
        pcall(hideAllDrawings)
        trackedMobs, trackedCorrupt, trackedRifts, trackedNPCs, trackedItems = {}, {}, {}, {}, {}
        mobCands = {}
        drawMobs = {}
        drawItems = {}
        drawDirty = true
        trackedBeastTamer = nil
        trackedChakraUsers = {}
        trackedChakraCount = 0
        JutsuRadar.roots = {}
        JutsuRadar.near = {}
        JutsuRadar.order = {}
        JutsuRadar.activeCasts = {}
        SubRadar.cache = {}
        SubRadar.lastVal = {}
        SubRadar.expiresAt = {}
        IFrameRadar.cache = {}
        ModeRadar.cache = {}
        StunRadar.cache = {}
        BX.vals = {}
        BX.posCache = {}
        negUntil = {}
        negName = {}
        lastMyPos = myPos or camPos
    end
    lastCamPos = camPos
    if myPos and isValidVec3(myPos) then lastMyPos = myPos end

    if drawDirty or lastDrawSettingsVersion ~= settingsVersion then
        rebuildDrawLists()
    end


    pcall(renderMobs)
    pcall(renderCorrupt)
    pcall(renderRifts)
    pcall(renderNPCs)
    pcall(renderItems)
    pcall(renderChakraHud)
    pcall(renderBeastTamer)
    tagOffsets = {}
    pcall(renderJutsuTags)
    pcall(renderSubTags)
    pcall(renderIFrameTags)
    pcall(renderModeTags)
    pcall(renderStunTags)
end

BX.onRender = function(now)
    now = now or os.clock()
    BX.beatRender = now
    rNow = now
    if not alive() then
        if _G.Bloodline_cleanup then
            pcall(_G.Bloodline_cleanup)
            _G.Bloodline_cleanup = nil
        end
        return
    end

    -- Direct hardware click & key detection (0ms latency, bypasses Roblox GUI input sinks)
    if ismouse1pressed then
        local isM1 = ismouse1pressed()
        if isM1 and not lastM1State then
            local lp = Players.LocalPlayer
            local mouse = lp and lp:GetMouse()
            if mouse then
                pcall(handleLeftClick, mouse.X, mouse.Y)
            end
        end
        lastM1State = isM1
    end

    if iskeypressed then
        local isX = iskeypressed(0x58) -- VK_KEY_X
        if isX and not lastXState then
            if cardVisible then pcall(hideProfileCard) end
        end
        lastXState = isX
    end

    _G.Bloodline_renderFrameCount = _G.Bloodline_renderFrameCount + 1

    if now - lastSettingsPoll >= SETTINGS_POLL then
        lastSettingsPoll = now
        pcall(refreshSettings)
    end

    local ok, err = pcall(renderFrame)
    if not ok then
        _G.Bloodline_lastError = tostring(err)
        logDebug("RenderStepped error: " .. tostring(err))
    end

    -- load shedding: adaptive backoff that protects slow PCs from graphics crashes while keeping fast PCs at 90 FPS
    local cost = os.clock() - now
    if cost > 0.008 then
        local b = (cost - 0.008) * 1.5
        if b > 0.025 then b = 0.025 end
        if b > BX.backoff then BX.backoff = b end
    else
        BX.backoff = BX.backoff * 0.85
        if BX.backoff < 0.0005 then BX.backoff = 0 end
    end
end

BX.connectRender = function()
    _G.Bloodline_renderConn = RunService.RenderStepped:Connect(function()
        local now = os.clock()
        if (now - lastRenderClock) < (MIN_FRAME_TIME + BX.backoff) then return end
        lastRenderClock = now
        local okR, eR = pcall(BX.onRender, now)
        if not okR then logDebug("Render callback error: " .. tostring(eR)) end
    end)
end
BX.connectRender()

