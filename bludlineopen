local lastAliveCheck = 0
local cachedAlive = true
local function alive()
    if _G.Bloodline_running ~= true or _G.Bloodline_gen ~= MY_GEN then
        return false
    end
    local now = os.clock()
    if (now - lastAliveCheck) < 0.25 then
        return cachedAlive
    end
    lastAliveCheck = now
    local okLP, lp = pcall(function() return Players.LocalPlayer end)
    if not okLP or not lp then
        cachedAlive = false
        _G.Bloodline_running = false
        return false
    end
    local okPar, par = pcall(function() return lp.Parent end)
    if not okPar or par ~= Players then
        cachedAlive = false
        _G.Bloodline_running = false
        return false
    end
    local okW, wPar = pcall(function() return Workspace.Parent end)
    if not okW or not wPar then
        cachedAlive = false
        _G.Bloodline_running = false
        return false
    end
    cachedAlive = true
    return true
end

local function safeRemove(d)
    if d then
        pcall(function() d.Visible = false end)
        pcall(function() d:Remove() end)
    end
end

