local function renderSubTags()
    local tags = SubRadar.tags
    local count = 0
    if S.bl_sub_en and JutsuRadar.order then
        local order = JutsuRadar.order
        local roots = JutsuRadar.roots
        local near = JutsuRadar.near
        local activeCasts = JutsuRadar.activeCasts
        local maxTags = #tags
        local curEpoch = os.time()
        local subTagSize = S.bl_sub_size or 13
        local lp = Players.LocalPlayer
        local myName = lp and lp.Name

        local maxDist = S.bl_combat_dist or 400
        for i = 1, #order do
            if count >= maxTags then break end
            local pn = order[i]
            local d = near[pn]
            if not d or d > maxDist then break end
            local isSelf = (myName and pn == myName) or (lp and pn == lp.Name)
            if isSelf and not S.bl_sub_self then
                -- skip self if not enabled
            else
                local root = roots[pn]
                if root then
                    local sc = SubRadar.cache[pn]
                    if (rNow - (SubRadar.cacheAt[pn] or 0)) > 8.0 then
                        local rsSettings = JutsuRadar.rsSettingsCache or game:GetService("ReplicatedStorage"):FindFirstChild("Settings")
                        local f = rsSettings and rsSettings:FindFirstChild(pn)
                        sc = f and f:FindFirstChild("SubCooldown")
                        SubRadar.cache[pn] = sc
                        SubRadar.cacheAt[pn] = rNow
                    end

                    if sc then
                        local okV, subVal = BX.get(sc)
                        if okV and type(subVal) == "number" then
                            local lastTs = SubRadar.lastVal[pn]
                            if lastTs == nil then
                                -- Initial baseline for this player
                                SubRadar.lastVal[pn] = subVal
                            elseif subVal > 0 and subVal > lastTs then
                                -- A higher timestamp was written by the server: FRESH SUB ACTIVATION!
                                SubRadar.lastVal[pn] = subVal
                                SubRadar.expiresAt[pn] = rNow + SUB_DURATION
                            elseif subVal <= 0 then
                                -- Stun / lock / reset state
                                SubRadar.expiresAt[pn] = nil
                            end

                            local exp = SubRadar.expiresAt[pn]
                            local label, col
                            if exp and rNow < exp then
                                local secLeft = math.ceil(exp - rNow)
                                label = "[SUB: " .. tostring(secLeft) .. "s]"
                                col = BX.RGB(255, 75, 75)
                            elseif not S.bl_sub_only_cd then
                                label = "[SUB READY]"
                                col = BX.RGB(60, 255, 110)
                            end

                            if label then
                                local okP, rPos = BX.pos(root)
                                if okP and isValidVec3(rPos) then
                                    local okS, sp, onScreen = pcall(WorldToScreen, rPos)
                                    if okS and onScreen and isValidVec2(sp) then
                                        local dist = (rCamPos - rPos).Magnitude
                                        local rawH = (5.5 / (max(dist, 1) * rTan)) * rVpH
                                        if isValidNum(rawH) then
                                            local h = clamp(floor(rawH), 16, 450)
                                            count = count + 1
                                            local t = tags[count]

                                            if t.text ~= label then
                                                t.tag.Text = label
                                                t.text = label
                                            end
                                            if t.col ~= col then
                                                t.tag.Color = col
                                                t.col = col
                                            end
                                            if t.size ~= subTagSize then
                                                t.tag.Size = subTagSize
                                                t.size = subTagSize
                                            end

                                            local curOff = tagOffsets[pn] or 20
                                            local subStep = math.floor(subTagSize + 6)
                                            tagOffsets[pn] = curOff + subStep
                                            local x, y = floor(sp.X), floor(sp.Y - floor(h * 0.5) - curOff)
                                            if t.x ~= x or t.y ~= y then
                                                t.x = x; t.y = y
                                                t.tag.Position = Vector2.new(x, y)
                                            end
                                            if not t.vis then
                                                t.tag.Visible = true
                                                t.vis = true
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    hideSubTags(count + 1)
end

