-- Persistent Debug Logger (rate-limited: a repeating error can no longer hammer the disk every frame)
local lastLogMsg, lastLogAt = "", -100
local function writeLogLine(line)
    appendfile("bloodline_debug.txt", line)
end
local function logDebug(msg, force)
    msg = tostring(msg)
    local now = os.clock()
    if not force then
        if (now - lastLogAt) < 0.5 then return end
        if msg == lastLogMsg and (now - lastLogAt) < 5 then return end
    end
    lastLogMsg = msg
    lastLogAt = now
    pcall(writeLogLine, string.format("[%s] %s\n", os.date("%X"), msg))
end

