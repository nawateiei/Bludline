local function getJutsuColor(skillName)
    if not skillName then return JUTSU_COLORS.DEFAULT end
    local c = BX.jutsuMemo[skillName]
    if not c then c = BX.jutsuColorRaw(skillName); BX.jutsuMemo[skillName] = c end
    return c
end
function BX.jutsuColorRaw(skillName)
    if not skillName then return JUTSU_COLORS.DEFAULT end
    local exact = EXACT_SPELL_MAP[skillName]
    if exact then return exact end

    local s = string.lower(skillName)

    -- Specific keyword matching (order prioritized)
    if string.find(s, "amaterasu") or string.find(s, "phoenix") or string.find(s, "flame") or string.find(s, "fire")
        or string.find(s, "blaze") or string.find(s, "burn") or string.find(s, "inferno") or string.find(s, "spark")
        or string.find(s, "ember") or string.find(s, "asakujaku") then
        return JUTSU_COLORS.FLAME
    end

    if string.find(s, "genjutsu") or string.find(s, "illusion") or string.find(s, "mirage")
        or string.find(s, "scrambled") or string.find(s, "crow") or string.find(s, "izanagi")
        or string.find(s, "tsukuyomi") then
        return JUTSU_COLORS.GENJUTSU
    end

    if string.find(s, "bamboozle") or string.find(s, "clone") then
        return JUTSU_COLORS.CLONE
    end

    if string.find(s, "heal") or string.find(s, "purif") or string.find(s, "coalesc")
        or string.find(s, "cure") or string.find(s, "vital") or string.find(s, "mystical palm") then
        return JUTSU_COLORS.HEALING
    end

    if string.find(s, "wood") or string.find(s, "forest") or string.find(s, "timber") or string.find(s, "tree") then
        return JUTSU_COLORS.WOOD
    end

    if string.find(s, "ice") or string.find(s, "frost") or string.find(s, "frozen")
        or string.find(s, "mirror") or string.find(s, "blizzard") or string.find(s, "glacier") then
        return JUTSU_COLORS.ICE
    end

    if string.find(s, "sand") or string.find(s, "desert") or string.find(s, "dune") then
        return JUTSU_COLORS.SAND
    end

    if string.find(s, "earth") or string.find(s, "mud") or string.find(s, "rock")
        or string.find(s, "stone") or string.find(s, "boulder") or string.find(s, "ground")
        or string.find(s, "dome defense") then
        return JUTSU_COLORS.EARTH
    end

    if string.find(s, "water") or string.find(s, "aqua") or string.find(s, "pool")
        or string.find(s, "wave") or string.find(s, "tide") or string.find(s, "shark")
        or string.find(s, "fountain") or string.find(s, "prison") then
        return JUTSU_COLORS.WATER
    end

    if string.find(s, "lightning") or string.find(s, "chidori") or string.find(s, "kirin")
        or string.find(s, "raikiri") or string.find(s, "thunder") or string.find(s, "shock")
        or string.find(s, "bolt") or string.find(s, "electric") then
        return JUTSU_COLORS.LIGHTNING
    end

    if string.find(s, "seal") or string.find(s, "chain") or string.find(s, "bind")
        or string.find(s, "reaper") then
        return JUTSU_COLORS.SEALING
    end

    if string.find(s, "wind") or string.find(s, "gale") or string.find(s, "rasen")
        or string.find(s, "whirlwind") or string.find(s, "vacuum") or string.find(s, "gust")
        or string.find(s, "air") or string.find(s, "tempest") then
        return JUTSU_COLORS.WIND
    end

    if string.find(s, "chakra") or string.find(s, "palm") or string.find(s, "byakugan")
        or string.find(s, "strike") then
        return JUTSU_COLORS.CHAKRA
    end

    return JUTSU_COLORS.DEFAULT
end

