local settingsVersion = 0
local FPS_PRESETS = {30, 60, 90, 120, 144}
local function snapToPreset(n)
    local best = FPS_PRESETS[1]
    local minDiff = math.abs(n - best)
    for i = 2, #FPS_PRESETS do
        local diff = math.abs(n - FPS_PRESETS[i])
        if diff < minDiff then
            minDiff = diff
            best = FPS_PRESETS[i]
        end
    end
    return best
end

local MAX_RENDER_FPS = 90
local MIN_FRAME_TIME = (0.85 / 90)

local function updateFpsTiming()
    local targetFps = S.bl_esp_fps or 90
    if S.bl_fps_snap then targetFps = snapToPreset(targetFps) end
    MAX_RENDER_FPS = targetFps
    MIN_FRAME_TIME = (targetFps > 0) and (0.85 / targetFps) or 0
end

