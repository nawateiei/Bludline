-- ---------------- JUTSU CHANNELING OVERHEAD TAGS ----------------
-- The root is looked up BY PLAYER NAME every frame (JutsuRadar.roots is refreshed twice a second),
-- so a respawn / new character can never leave a tag stuck on a dead root. Position/text writes
-- only happen when the value actually changed.
local tagOffsets = {}
local function hideJutsuTags(from)
    local tags = JutsuRadar.tags
    for i = from, #tags do
        local t = tags[i]
        if t.vis then
            t.tag.Visible = false
            t.vis = false
        end
        if t.boxVis then
            t.box.Visible = false
            t.boxVis = false
        end
    end
end

local function renderJutsuTags()
    local tags = JutsuRadar.tags
    local count = 0
    if S.bl_jutsu_tag and next(JutsuRadar.activeCasts) then
        local maxTags = #tags
        local roots = JutsuRadar.roots
        local showBox = S.bl_jutsu_box
        for _, cast in pairs(JutsuRadar.activeCasts) do
            if count >= maxTags then break end
            if rNow < cast.expireTime then
                local root = (cast.who and roots[cast.who]) or cast.root
                if root then
                    local okP, rPos = pcall(getPosOf, root)
                    if okP and isValidVec3(rPos) then
                        local okS, sp, onScreen = pcall(WorldToScreen, rPos)
                        if okS and onScreen and isValidVec2(sp) then
                            local dist = (rCamPos - rPos).Magnitude
                            local rawH = (5.5 / (max(dist, 1) * rTan)) * rVpH
                            if isValidNum(rawH) then
                                local h = clamp(floor(rawH), 16, 450)
                                count = count + 1
                                local t = tags[count]
                                if t.text ~= cast.label then
                                    t.tag.Text = cast.label
                                    t.text = cast.label
                                end
                                local tagCol = getJutsuColor(cast.skill)
                                if t.tag.Color ~= tagCol then t.tag.Color = tagCol end
                                local tagSize = S.bl_jutsu_size or 13
                                if t.size ~= tagSize then
                                    t.tag.Size = tagSize
                                    t.size = tagSize
                                end
                                local who = cast.who
                                local curOff = (who and tagOffsets[who]) or 20
                                local jutsuStep = math.floor(tagSize + (showBox and 8 or 2) + 6)
                                if who then tagOffsets[who] = curOff + jutsuStep end
                                local x, y = floor(sp.X), floor(sp.Y - floor(h * 0.5) - curOff)
                                if t.x ~= x or t.y ~= y then
                                    t.x = x; t.y = y
                                    t.tag.Position = Vector2.new(x, y)
                                end
                                if not t.vis then
                                    t.tag.Visible = true
                                    t.vis = true
                                end

                                if showBox then
                                    local textLen = #cast.label
                                    local charW = math.max(tagSize * 0.58, 7.0)
                                    local textWidth = math.max(textLen * charW, 36)
                                    local padX = math.floor(tagSize * 0.30) + 3
                                    local bw = floor(textWidth + padX * 2)
                                    local bh = floor(tagSize + 5)
                                    local bx = floor(x - bw * 0.5)
                                    local by = floor(y - bh * 0.5)
                                    if t.bx ~= bx or t.by ~= by or t.bw ~= bw or t.bh ~= bh then
                                        t.bx = bx; t.by = by; t.bw = bw; t.bh = bh
                                        t.box.Size = Vector2.new(bw, bh)
                                        t.box.Position = Vector2.new(bx, by)
                                    end
                                    if not t.boxVis then
                                        t.box.Visible = true
                                        t.boxVis = true
                                    end
                                elseif t.boxVis then
                                    t.box.Visible = false
                                    t.boxVis = false
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    hideJutsuTags(count + 1)
end

