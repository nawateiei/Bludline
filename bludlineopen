-- ============================================================
--  LOOP 1: FAST 0.35s COLLECTOR
--  - Universal Pickupable Item Detection (Fruits, Bells, Seaweed)
--  - Corruption Points Scanner (game.Workspace.CorruptedPoint)
--  - Precision Mob Classifier (Excludes Town NPCs cleanly)
-- ============================================================
local trackedMobs          = {}
local trackedCorrupt       = {}
local trackedNPCs          = {}
local trackedItems         = {}
local notifiedItems        = {}
local trackedChakraUsers   = {}
local notifiedChakraUsers  = {}
local lastChakraCastState  = {}
local trackedBeastTamer    = nil
local notifiedBeastTamer   = {}

task.spawn(function()
    while _G.Bloodline_running do
        local okScan, scanErr = pcall(function()
            local lp = Players.LocalPlayer
            local lpChar = lp and lp.Character
            local lpRoot = lpChar and (lpChar:FindFirstChild("HumanoidRootPart") or lpChar:FindFirstChild("Torso"))
            local myPos = lpRoot and lpRoot.Position or Vector3.new(0, 0, 0)
            local myName = lp and lp.Name or ""

            local playerNames = {}
            local pList = Players:GetPlayers()
            for i = 1, #pList do
                local p = pList[i]
                if p then playerNames[tostring(p.Name or "")] = true end
            end

            local children = Workspace:GetChildren()
            local total = #children
            local freshMobs       = {}
            local freshCorrupt    = {}
            local freshNPCs       = {}
            local freshItems      = {}
            local liveFruitAddrs  = {}
            local freshBeastTamer = nil
            local liveBeastKeys   = {}

            for i = 1, total do
                local obj = children[i]
                if not obj then continue end

                local cname = obj.ClassName
                -- Quick scenery skip
                if cname == "Part" or cname == "WedgePart" or cname == "CornerWedgePart" or cname == "TrussPart" or cname == "Terrain" or cname == "Folder" then
                    continue
                end

                local objName = tostring(obj.Name or "")
                if STATIC_PROP_NAMES[objName] or COMMON_RINGS[objName] then continue end

                -- 0. SPECIAL EVENT SCANNER: "Beast Tamer"
                if cname == "Model" and (objName == "Beast Tamer" or string.find(string.lower(objName), "beast tamer")) then
                    local root = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso") or obj:FindFirstChildOfClass("BasePart")
                    if root then
                        local okP, p = pcall(function() return root.Position end)
                        local okAddr, addr = pcall(function() return obj.Address end)
                        local key = addr or objName
                        if okP and isValidVec3(p) then
                            freshBeastTamer = {
                                model = obj,
                                root  = root,
                                pos   = p,
                                key   = key
                            }
                            liveBeastKeys[key] = true
                            if not notifiedBeastTamer[key] then
                                notifiedBeastTamer[key] = true
                                if getUI("bl_ev_beast_tamer", true) then
                                    local d = math.floor((myPos - p).Magnitude)
                                    notify("EVENT ALERT!", string.format("Beast Tamer has spawned! [%dm away]", d), 10)
                                end
                            end
                        end
                    end
                    continue
                end

                -- 1. CORRUPTED POINT SCANNER (game.Workspace.CorruptedPoint)
                if objName == "CorruptedPoint" and cname == "Model" then
                    local dest = obj:FindFirstChild("Destroyed")
                    local isDestroyed = dest and dest.Value == true
                    if not (getUI("bl_corrupt_dest", true) and isDestroyed) then
                        local main = obj:FindFirstChild("Main") or obj:FindFirstChild("InnerPool") or obj:FindFirstChildOfClass("BasePart")
                        if main then
                            local okP, p = pcall(function() return main.Position end)
                            if okP and isValidVec3(p) then
                                table.insert(freshCorrupt, {
                                    pos = p,
                                    isDestroyed = isDestroyed
                                })
                            end
                        end
                    end

                -- 2. UNIVERSAL PICKUPABLE ITEM DETECTOR
                -- Matches Fruits, Scrolls, Sealing Bells, Training Bells, Seaweed, and ClickDetector/PickUp items
                elseif cname ~= "Camera" then
                    -- Quick skip for known combat VFX parts or static jewelry props
                    if STATIC_PROP_NAMES[objName]
                        or COMMON_RINGS[objName]
                        or objName == "Ring"
                        or objName == "Gold Enclosed Ring"
                        or objName == "Necklace"
                        or string.find(objName, "Shock")
                        or string.find(objName, "ThinRing")
                        or string.find(objName, "MovingRing") then
                        continue
                    end

                    local isRareRing = (RARE_ITEMS[objName] ~= nil and RARE_ITEMS[objName].filter == "Rings")

                    local isPickupable = (KNOWN_ITEMS[objName] and not COMMON_RINGS[objName])
                        or RARE_ITEMS[objName] ~= nil
                        or isRareRing
                        or string.find(objName, "Schematic")
                        or string.find(objName, " Eyes")
                        or obj:FindFirstChild("ItemDetector") ~= nil
                        or obj:FindFirstChild("PickUp") ~= nil
                        or obj:FindFirstChild("Pickupable") ~= nil
                        or obj:FindFirstChildOfClass("ClickDetector") ~= nil
                        or obj:FindFirstChildOfClass("ProximityPrompt") ~= nil

                    if isPickupable then
                        local isCommonRing = COMMON_RINGS[objName]
                            or (objName:lower() == "ring")
                            or (objName:lower() == "gold ring")
                            or (objName:lower() == "golden ring")
                            or (objName:lower() == "gold enclosed ring")
                            or (objName:lower() == "common ring")
                            or (objName:lower() == "necklace")

                        if isCommonRing then
                            continue
                        end

                        local rareInfo = RARE_ITEMS[objName]
                        if not rareInfo then
                            if string.find(objName, "Schematic") then
                                rareInfo = { color = Color3.fromRGB(100, 190, 255), label = "★ " .. objName .. " ★", filter = "Schematics" }
                            elseif string.find(objName, " Eyes") then
                                rareInfo = { color = Color3.fromRGB(255, 45, 75), label = "★ " .. objName .. " ★", filter = "Eyes" }
                            end
                        end
                        local okPos, pos = pcall(function()
                            local p = obj.Position
                            if not p and cname == "Model" then
                                local part = obj.PrimaryPart or obj:FindFirstChild("Handle") or obj:FindFirstChildOfClass("Part") or obj:FindFirstChildOfClass("MeshPart")
                                p = part and part.Position
                            end
                            return p
                        end)
                        local okAddr, addr = pcall(function() return obj.Address end)

                        if okPos and isValidVec3(pos) then
                            if rareInfo and okAddr and addr then
                                liveFruitAddrs[addr] = true
                                if not notifiedItems[addr] then
                                    notifiedItems[addr] = true
                                    if getUI("bl_rare_notif", true) then
                                        local d = math.floor((myPos - pos).Magnitude)
                                        notify("Rare Item Alert!", string.format("%s spawned near you! [%dm away]", rareInfo.label, d), 8)
                                    end
                                end
                            end

                            table.insert(freshItems, {
                                item     = obj,
                                name     = objName,
                                pos      = pos,
                                isRare   = (rareInfo ~= nil),
                                rareInfo = rareInfo
                            })
                        end

                    -- 3. Models (Combat Mobs & Town NPCs)
                    elseif cname == "Model" and objName:sub(1, 4) ~= "Tree" and objName:sub(1, 7) ~= "Caravan" then
                        if not playerNames[objName] and objName ~= myName then
                            local tagObj = obj:FindFirstChild("NPC")
                            if tagObj then
                                local hum = obj:FindFirstChildOfClass("Humanoid")
                                local root = obj:FindFirstChild("HumanoidRootPart")
                                    or obj:FindFirstChild("Torso")
                                    or obj:FindFirstChild("UpperTorso")

                                if hum and root then
                                    local okHp, hp = pcall(function() return hum.Health end)
                                    if okHp and isValidNum(hp) and hp > 0 then
                                        local tagVal = tostring(tagObj.Value or "")
                                        local maxHp = hum.MaxHealth or 100

                                        -- Precision Friendly vs Combat Classifier
                                        local isKnownFriendly = (tagVal == "Dialog")
                                            or FRIENDLY_NPCS[objName]
                                            or (maxHp <= 100 and tagVal ~= "Combat" and not objName:find("Bandit") and not objName:find("Guard") and not objName:find("Clone"))

                                        local isCombat = not isKnownFriendly and (
                                            (tagVal == "Combat")
                                            or (objName:find("Bandit") ~= nil)
                                            or (objName:find("Guard") ~= nil)
                                            or (objName:find("Manda") ~= nil)
                                            or (objName:find("Snake") ~= nil)
                                            or (objName:find("Rogue") ~= nil)
                                            or (objName:find("Zetsu") ~= nil)
                                            or (objName:find("Boss") ~= nil)
                                            or (objName:find("Lavarossa") ~= nil)
                                            or (objName:find("The Barbarian") ~= nil)
                                            or (objName:find("Barbarit") ~= nil)
                                            or (objName:find("Clone") ~= nil)
                                            or (objName:find("Dummy") ~= nil)
                                            or (objName:find("Instructor Clone") ~= nil)
                                            or (objName:find("Clay Runner") ~= nil)
                                            or (objName:find("Runner") ~= nil)
                                            or (objName:find("Cratos") ~= nil)
                                            or (objName:find("Tairock") ~= nil)
                                            or (maxHp > 100)
                                            or (hp < maxHp)
                                        )

                                        local cleanName = getUI("bl_mob_clean", true) and string.gsub(objName, "%d+$", "") or objName

                                        if isCombat then
                                            table.insert(freshMobs, {
                                                root      = root,
                                                hum       = hum,
                                                name      = cleanName,
                                                maxHp     = maxHp
                                            })
                                        else
                                            table.insert(freshNPCs, {
                                                root      = root,
                                                name      = cleanName
                                            })
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end

            for addr, _ in pairs(notifiedItems) do
                if not liveFruitAddrs[addr] then
                    notifiedItems[addr] = nil
                end
            end

            trackedMobs    = freshMobs
            trackedCorrupt = freshCorrupt
            trackedNPCs    = freshNPCs
            trackedItems   = freshItems

            -- 4. CHAKRA SENSE SCANNER (game.ReplicatedStorage.Cooldowns)
            local freshChakra = {}
            if getUI("bl_cs_en", true) then
                local cdFolder = game:GetService("ReplicatedStorage"):FindFirstChild("Cooldowns")
                if cdFolder then
                    local cdList = cdFolder:GetChildren()
                    for i = 1, #cdList do
                        local pFolder = cdList[i]
                        if pFolder then
                            local csVal = pFolder:FindFirstChild("Chakra Sense")
                            if csVal then
                                local pName = pFolder.Name
                                local char = Workspace:FindFirstChild(pName)
                                local torso = char and (char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso"))
                                local isCasting = torso and (torso:FindFirstChild("ChakraSense") ~= nil) or false

                                table.insert(freshChakra, {
                                    name = pName,
                                    isCasting = isCasting
                                })

                                -- Notify when detected in server
                                if not notifiedChakraUsers[pName] then
                                    notifiedChakraUsers[pName] = true
                                    if getUI("bl_cs_notify", true) then
                                        notify("Chakra Sense Detected!", string.format("%s has Chakra Sense in loadout!", pName), 7)
                                    end
                                end

                                -- Notify when actively casting
                                if isCasting then
                                    if not lastChakraCastState[pName] then
                                        lastChakraCastState[pName] = true
                                        if getUI("bl_cs_use_notify", true) then
                                            notify("CHAKRA SENSE ACTIVE!", string.format("%s is using Chakra Sense right now!", pName), 6)
                                        end
                                    end
                                else
                                    lastChakraCastState[pName] = false
                                end
                            end
                        end
                    end
                end
            end

            for pName, _ in pairs(notifiedChakraUsers) do
                if not playerNames[pName] then
                    notifiedChakraUsers[pName] = nil
                    lastChakraCastState[pName] = nil
                end
            end

            trackedChakraUsers = freshChakra

            for key, _ in pairs(notifiedBeastTamer) do
                if not liveBeastKeys[key] then
                    notifiedBeastTamer[key] = nil
                end
            end
            _G.Bloodline_beastTamerSpawned = (freshBeastTamer ~= nil)
            trackedBeastTamer = freshBeastTamer
        end)

        if not okScan then
            logDebug("Collector error: " .. tostring(scanErr))
        end

        task.wait(0.35)
    end
end)

-- ============================================================
--  LOOP 2: ZERO-LOOKUP 60-FPS RENDERER
-- ============================================================
local lastCamPos = Vector3.new(0, 0, 0)
local lastRenderClock = 0
local TARGET_FRAME_TIME = 1.0 / 60.0

_G.Bloodline_renderFrameCount = 0
_G.Bloodline_lastError = nil

_G.Bloodline_renderConn = RunService.RenderStepped:Connect(function()
    if not _G.Bloodline_running then return end

    local now = os.clock()
    if (now - lastRenderClock) < TARGET_FRAME_TIME then
        return
    end
    lastRenderClock = now

    _G.Bloodline_renderFrameCount = _G.Bloodline_renderFrameCount + 1

    local okGlobal, globalErr = pcall(function()
        local cam = Workspace.CurrentCamera
        if not cam then return end
        local camPos = cam.Position
        if not isValidVec3(camPos) then return end

        local viewport = cam.ViewportSize
        if not viewport or viewport.X <= 20 or viewport.Y <= 20 then return end
        local vpW = viewport.X
        local vpH = viewport.Y
        local screenBottomX = math.floor(vpW * 0.5)
        local screenBottomY = math.floor(vpH)

        local fovRad = math.rad(cam.FieldOfView or 70)
        local tanHalfFov2 = math.tan(fovRad * 0.5) * 2.0
        if not isValidNum(tanHalfFov2) or tanHalfFov2 <= 0.001 then return end

        -- Fast Travel Flush (>100 studs jump in 1 frame)
        local camDelta = (camPos - lastCamPos).Magnitude
        if camDelta > 100.0 then
            trackedMobs    = {}
            trackedCorrupt = {}
            trackedNPCs    = {}
            trackedItems   = {}
        end
        lastCamPos = camPos

        -- ========================================================
        -- 1. COMBAT MOBS
        -- ========================================================
        local mobSlot = 0
        local mobEnabled = getUI("bl_mob_en", true)

        if mobEnabled then
            local maxDist    = 100000
            local showBox    = getUI("bl_mob_box", true)
            local showHpBar  = getUI("bl_mob_hp_b", true)
            local showName   = getUI("bl_mob_name", true)
            local showHpTxt  = getUI("bl_mob_hp_t", true)
            local showDist   = getUI("bl_mob_dist", true)
            local bossOnly   = getUI("bl_mob_boss", false)
            local boxColor   = COL_RED
            local nameColor  = Color3.fromRGB(255, 255, 255)
            local mobs       = trackedMobs

            for i = 1, #mobs do
                if mobSlot >= MOB_POOL_SIZE then break end
                local m = mobs[i]

                pcall(function()
                    if bossOnly and m.maxHp <= 500 then return end

                    local rPos = m.root.Position
                    if not isValidVec3(rPos) then return end

                    local dist = (camPos - rPos).Magnitude
                    if dist <= maxDist and dist > 0.5 then
                        local screenPos, onScreen = WorldToScreen(rPos)
                        if onScreen and isValidVec2(screenPos) then
                            local rawH = (5.5 / (dist * tanHalfFov2)) * vpH
                            if not isValidNum(rawH) then return end

                            local h = math.clamp(math.floor(rawH), 16, 450)
                            local w = math.clamp(math.floor(h * 0.55), 8, 300)
                            local halfW = math.floor(w * 0.5)
                            local halfH = math.floor(h * 0.5)
                            local boxX = math.floor(screenPos.X - halfW)
                            local boxY = math.floor(screenPos.Y - halfH)

                            if not isValidNum(boxX) or not isValidNum(boxY) then return end

                            local hp = m.hum.Health
                            if not isValidNum(hp) or hp <= 0 then return end
                            local maxHp = m.maxHp
                            local hpPct = math.clamp(hp / maxHp, 0, 1)
                            local fillH = math.clamp(math.floor(h * hpPct), 0, h)

                            mobSlot = mobSlot + 1
                            local e = mobPool[mobSlot]

                            -- Box
                            if showBox then
                                e.box.Position = Vector2.new(boxX, boxY)
                                e.box.Size = Vector2.new(w, h)
                                if not e.box.Visible then
                                    e.box.Color = boxColor
                                    e.box.Visible = true
                                end
                            elseif e.box.Visible then
                                e.box.Visible = false
                            end

                            -- Health Bar
                            if showHpBar then
                                local barX = boxX - 5
                                e.barBg.Position = Vector2.new(barX, boxY)
                                e.barBg.Size = Vector2.new(3, h)

                                e.bar.Position = Vector2.new(barX, boxY + (h - fillH))
                                e.bar.Size = Vector2.new(3, math.max(1, fillH))

                                local targetColor = (hpPct > 0.5 and COL_GREEN) or (hpPct > 0.25 and COL_YELLOW) or COL_RED
                                if e.lastBarColor ~= targetColor then
                                    e.bar.Color = targetColor
                                    e.lastBarColor = targetColor
                                end

                                if not e.barBg.Visible then
                                    e.barBg.Visible = true
                                    e.bar.Visible = true
                                end
                            elseif e.barBg.Visible then
                                e.barBg.Visible = false
                                e.bar.Visible = false
                            end

                            -- Name / HP Text / Distance
                            if showName or showHpTxt or showDist then
                                local dInt = math.floor(dist)
                                local curHp = math.floor(hp)
                                local label = ""

                                if showName then label = m.name end
                                if showHpTxt then label = label .. " [" .. curHp .. "/" .. math.floor(maxHp) .. "]" end
                                if showDist then label = label .. " " .. dInt .. "m" end

                                if e.lastText ~= label then
                                    e.tag.Text = tostring(label)
                                    e.lastText = label
                                end
                                e.tag.Position = Vector2.new(screenPos.X, boxY - 16)

                                if not e.tag.Visible then
                                    e.tag.Color = nameColor
                                    e.tag.Visible = true
                                end
                            elseif e.tag.Visible then
                                e.tag.Visible = false
                            end

                            e.isShown = true
                        end
                    end
                end)
            end
        end

        for i = mobSlot + 1, MOB_POOL_SIZE do
            hideMobSlot(mobPool[i])
        end

        -- ========================================================
        -- 2. CORRUPTION POINTS (game.Workspace.CorruptedPoint)
        -- ========================================================
        local corruptSlot = 0
        local corruptEnabled = getUI("bl_corrupt_en", true)

        if corruptEnabled then
            local maxDist   = 100000
            local showBox   = getUI("bl_corrupt_box", true)
            local showName  = getUI("bl_corrupt_name", true)
            local showDist  = getUI("bl_corrupt_dist", true)
            local boxColor  = COL_PURPLE
            local nameColor = COL_PURP_TXT
            local corrupts  = trackedCorrupt

            for i = 1, #corrupts do
                if corruptSlot >= CORRUPT_POOL_SIZE then break end
                local c = corrupts[i]

                pcall(function()
                    local pos = c.pos
                    if not isValidVec3(pos) then return end

                    local dist = (camPos - pos).Magnitude
                    if dist <= maxDist and dist > 0.5 then
                        local screenPos, onScreen = WorldToScreen(pos)
                        if onScreen and isValidVec2(screenPos) then
                            local rawH = (5.5 / (dist * tanHalfFov2)) * vpH
                            if not isValidNum(rawH) then return end

                            local h = math.clamp(math.floor(rawH), 16, 450)
                            local w = math.clamp(math.floor(h * 0.7), 10, 300)
                            local halfW = math.floor(w * 0.5)
                            local halfH = math.floor(h * 0.5)
                            local boxX = math.floor(screenPos.X - halfW)
                            local boxY = math.floor(screenPos.Y - halfH)

                            if not isValidNum(boxX) or not isValidNum(boxY) then return end

                            corruptSlot = corruptSlot + 1
                            local e = corruptPool[corruptSlot]

                            if showBox then
                                e.box.Position = Vector2.new(boxX, boxY)
                                e.box.Size = Vector2.new(w, h)
                                if not e.box.Visible then
                                    e.box.Color = boxColor
                                    e.box.Visible = true
                                end
                            elseif e.box.Visible then
                                e.box.Visible = false
                            end

                            if showName or showDist then
                                local label = ""
                                if showName then label = "Corrupted Point" end
                                if showDist then label = label .. " [" .. math.floor(dist) .. "m]" end

                                if e.lastText ~= label then
                                    e.tag.Text = tostring(label)
                                    e.lastText = label
                                end
                                e.tag.Position = Vector2.new(screenPos.X, boxY - 16)

                                if not e.tag.Visible then
                                    e.tag.Color = nameColor
                                    e.tag.Visible = true
                                end
                            elseif e.tag.Visible then
                                e.tag.Visible = false
                            end

                            e.isShown = true
                        end
                    end
                end)
            end
        end

        for i = corruptSlot + 1, CORRUPT_POOL_SIZE do
            hideCorruptSlot(corruptPool[i])
        end

        -- ========================================================
        -- 3. TOWN & FRIENDLY NPCS (Disabled by default)
        -- ========================================================
        local npcSlot = 0
        local npcEnabled = getUI("bl_npc_en", false)

        if npcEnabled then
            local maxDist   = 100000
            local showBox   = getUI("bl_npc_box", true)
            local showName  = getUI("bl_npc_name", true)
            local showDist  = getUI("bl_npc_dist", true)
            local boxColor  = Color3.fromRGB(0, 210, 255)
            local nameColor = Color3.fromRGB(255, 255, 255)
            local npcs      = trackedNPCs

            for i = 1, #npcs do
                if npcSlot >= NPC_POOL_SIZE then break end
                local n = npcs[i]

                pcall(function()
                    local rPos = n.root.Position
                    if not isValidVec3(rPos) then return end

                    local dist = (camPos - rPos).Magnitude
                    if dist <= maxDist and dist > 0.5 then
                        local screenPos, onScreen = WorldToScreen(rPos)
                        if onScreen and isValidVec2(screenPos) then
                            local rawH = (5.5 / (dist * tanHalfFov2)) * vpH
                            if not isValidNum(rawH) then return end

                            local h = math.clamp(math.floor(rawH), 16, 450)
                            local w = math.clamp(math.floor(h * 0.55), 8, 300)
                            local halfW = math.floor(w * 0.5)
                            local halfH = math.floor(h * 0.5)
                            local boxX = math.floor(screenPos.X - halfW)
                            local boxY = math.floor(screenPos.Y - halfH)

                            if not isValidNum(boxX) or not isValidNum(boxY) then return end

                            npcSlot = npcSlot + 1
                            local e = npcPool[npcSlot]

                            if showBox then
                                e.box.Position = Vector2.new(boxX, boxY)
                                e.box.Size = Vector2.new(w, h)
                                if not e.box.Visible then
                                    e.box.Color = boxColor
                                    e.box.Visible = true
                                end
                            elseif e.box.Visible then
                                e.box.Visible = false
                            end

                            if showName or showDist then
                                local label = n.name
                                if showDist then label = label .. " [" .. math.floor(dist) .. "m]" end

                                if e.lastText ~= label then
                                    e.tag.Text = tostring(label)
                                    e.lastText = label
                                end
                                e.tag.Position = Vector2.new(screenPos.X, boxY - 16)

                                if not e.tag.Visible then
                                    e.tag.Color = nameColor
                                    e.tag.Visible = true
                                end
                            elseif e.tag.Visible then
                                e.tag.Visible = false
                            end

                            e.isShown = true
                        end
                    end
                end)
            end
        end

        for i = npcSlot + 1, NPC_POOL_SIZE do
            hideNPCSlot(npcPool[i])
        end

        -- ========================================================
        -- 4. ITEMS (Fruits, Bells, Seaweed & Drops)
        -- ========================================================
        local itemSlot = 0
        local itemEnabled = getUI("bl_item_en", true)

        if itemEnabled then
            local maxDist     = 100000
            local showBox     = getUI("bl_item_box", true)
            local showName    = getUI("bl_item_name", true)
            local showDist    = getUI("bl_item_dist", true)
            local showTracers = getUI("bl_rare_trc", true)
            local items       = trackedItems

            for i = 1, #items do
                if itemSlot >= ITEM_POOL_SIZE then break end
                local it = items[i]

                pcall(function()
                    local isRare = it.isRare
                    local rareInfo = it.rareInfo
                    local name = it.name

                    -- Granular Toggle Filter: Bells, Seaweed, Fruits, Drops
                    local isAllowed = false
                    if isRare then
                        if rareInfo then
                            local f = rareInfo.filter
                            if f == "Life Up Fruit" then
                                isAllowed = getUI("bl_r_life", true)
                            elseif f == "Fruit of Forgetfulness" then
                                isAllowed = getUI("bl_r_forg", true)
                            elseif f == "Chakra Fruit" then
                                isAllowed = getUI("bl_r_chak", true)
                            elseif f == "Scrolls" then
                                isAllowed = getUI("bl_r_scrl", true)
                            elseif f == "Rings" then
                                isAllowed = getUI("bl_r_rings", true)
                            elseif f == "Schematics" then
                                isAllowed = getUI("bl_r_schem", true)
                            elseif f == "Eyes" then
                                isAllowed = getUI("bl_r_eyes", true)
                            else
                                isAllowed = true
                            end
                        end
                    else
                        if name:find("Bells") then
                            isAllowed = getUI("f_bells", false)
                        elseif name:find("Gloweed") or name:find("Glowweed") then
                            isAllowed = getUI("f_gloweed", false)
                        elseif name:find("Seaweed") or name:find("Weed") then
                            isAllowed = getUI("f_seaweed", false)
                        elseif name == "Apple"
                            or name == "Alluring Apple"
                            or name == "Banana"
                            or name == "Orange"
                            or name == "Pear"
                            or name == "Mango" then
                            isAllowed = getUI("f_common_fruit", true)
                        else
                            isAllowed = getUI("f_other", true)
                        end
                    end
                    if not isAllowed then return end

                    local pos = it.pos or (it.item and it.item.Position)
                    if not isValidVec3(pos) then return end

                    local dist = (camPos - pos).Magnitude
                    if dist <= maxDist and dist > 0.5 then
                        local screenPos, onScreen = WorldToScreen(pos)
                        if onScreen and isValidVec2(screenPos) then
                            local radiusStuds = isRare and 2.4 or 1.6
                            local rawH = (radiusStuds / (dist * tanHalfFov2)) * vpH
                            if not isValidNum(rawH) then return end

                            local h = math.clamp(math.floor(rawH), 12, 140)
                            local w = math.clamp(math.floor(h * 0.9), 8, 120)
                            local boxX = math.floor(screenPos.X - w * 0.5)
                            local boxY = math.floor(screenPos.Y - h * 0.5)

                            if not isValidNum(boxX) or not isValidNum(boxY) then return end

                            itemSlot = itemSlot + 1
                            local e = itemPool[itemSlot]
                            local col = isRare and rareInfo and rareInfo.color or Color3.fromRGB(0, 255, 120)
                            local textColor = isRare and rareInfo and rareInfo.color or Color3.fromRGB(255, 255, 255)
                            local displayName = isRare and rareInfo and rareInfo.label or it.name

                            if showBox then
                                e.box.Position = Vector2.new(boxX, boxY)
                                e.box.Size = Vector2.new(w, h)
                                if not e.box.Visible then
                                    e.box.Color = col
                                    e.box.Visible = true
                                end
                            elseif e.box.Visible then
                                e.box.Visible = false
                            end

                            if showName or showDist then
                                local label = tostring(displayName or "Item")
                                if showDist then
                                    label = label .. " [" .. math.floor(dist) .. "m]"
                                end

                                if e.lastText ~= label then
                                    e.tag.Text = tostring(label)
                                    e.lastText = label
                                end
                                e.tag.Position = Vector2.new(screenPos.X, boxY - 16)

                                if not e.tag.Visible then
                                    e.tag.Color = textColor
                                    e.tag.Visible = true
                                end
                            elseif e.tag.Visible then
                                e.tag.Visible = false
                            end

                            if isRare and showTracers and rareInfo then
                                e.tracer.From = Vector2.new(screenBottomX, screenBottomY)
                                e.tracer.To = Vector2.new(screenPos.X, screenPos.Y)
                                if not e.tracer.Visible then
                                    e.tracer.Color = col
                                    e.tracer.Visible = true
                                end
                            elseif e.tracer.Visible then
                                e.tracer.Visible = false
                            end

                            e.isShown = true
                        end
                    end
                end)
            end
        end

        for i = itemSlot + 1, ITEM_POOL_SIZE do
            hideItemSlot(itemPool[i])
        end

        -- ========================================================
        -- 5. CHAKRA SENSE RADAR HUD OVERLAY
        -- ========================================================
        local csEnabled = getUI("bl_cs_en", true)
        local csHudEnabled = getUI("bl_cs_hud", true)
        local chakraList = trackedChakraUsers

        if csEnabled and csHudEnabled and #chakraList > 0 then
            local lines = {}
            for i = 1, #chakraList do
                local u = chakraList[i]
                local status = u.isCasting and "[CASTING NOW!]" or "[Idle]"
                table.insert(lines, string.format(" %s: %s", u.name, status))
            end
            local fullText = table.concat(lines, "\n")
            if lastCsHudText ~= fullText then
                csHudContent.Text = fullText
                lastCsHudText = fullText
            end
            if not csHudTitle.Visible then
                csHudTitle.Text = string.format("[Chakra Sense Radar (%d)]", #chakraList)
                csHudTitle.Visible = true
            end
            if not csHudContent.Visible then
                csHudContent.Visible = true
            end
        else
            if csHudTitle.Visible then csHudTitle.Visible = false end
            if csHudContent.Visible then csHudContent.Visible = false end
            lastCsHudText = ""
        end

        -- ========================================================
        -- 6. BEAST TAMER EVENT ESP & TRACER
        -- ========================================================
        local bt = trackedBeastTamer
        local btEspEnabled = getUI("bl_ev_beast_esp", true)

        if bt and btEspEnabled then
            pcall(function()
                local pos = bt.pos or (bt.root and bt.root.Position)
                if isValidVec3(pos) then
                    local dist = (camPos - pos).Magnitude
                    if dist > 0.5 then
                        local screenPos, onScreen = WorldToScreen(pos)
                        if onScreen and isValidVec2(screenPos) then
                            local rawH = (5.5 / (dist * tanHalfFov2)) * vpH
                            if isValidNum(rawH) then
                                local h = math.clamp(math.floor(rawH), 16, 260)
                                local w = math.clamp(math.floor(h * 0.5), 10, 140)
                                local boxX = math.floor(screenPos.X - w * 0.5)
                                local boxY = math.floor(screenPos.Y - h * 0.5)

                                if isValidNum(boxX) and isValidNum(boxY) then
                                    eventBox.Position = Vector2.new(boxX, boxY)
                                    eventBox.Size = Vector2.new(w, h)
                                    if not eventBox.Visible then eventBox.Visible = true end

                                    local label = string.format("★ BEAST TAMER ★ [%dm]", math.floor(dist))
                                    eventTag.Text = label
                                    eventTag.Position = Vector2.new(screenPos.X, boxY - 18)
                                    if not eventTag.Visible then eventTag.Visible = true end

                                    eventTracer.From = Vector2.new(screenBottomX, screenBottomY)
                                    eventTracer.To = Vector2.new(screenPos.X, screenPos.Y)
                                    if not eventTracer.Visible then eventTracer.Visible = true end
                                    return
                                end
                            end
                        end
                    end
                end
                hideEventSlot()
            end)
        else
            hideEventSlot()
        end
    end)

    if not okGlobal then
        _G.Bloodline_lastError = tostring(globalErr)
        logDebug("RenderStepped FATAL error: " .. tostring(globalErr))
        pcall(function()
            for _, s in ipairs(mobPool) do hideMobSlot(s) end
            for _, s in ipairs(corruptPool) do hideCorruptSlot(s) end
            for _, s in ipairs(npcPool) do hideNPCSlot(s) end
            for _, s in ipairs(itemPool) do hideItemSlot(s) end
            if csHudTitle and csHudTitle.Visible then csHudTitle.Visible = false end
            if csHudContent and csHudContent.Visible then csHudContent.Visible = false end
            hideEventSlot()
        end)
    end
end)

notify("Bloodline ESP", "Two-Loop Corruption Engine Activated!", 4)
logDebug("Bloodline ESP Two-Loop Engine running smoothly at 60 FPS!")
print("[Bloodline] Master Two-Loop Corruption Engine active!")
