local MemoryOffsets = {
    AnimationId                = 0x48,
    ClassDescriptor            = 0x18,
    ClassDescriptorToClassName = 0x8,
    Name                       = 0x48,
    TimePosition               = 0x80,
    ActiveAnimations           = 0x900,
    Animation                  = 0xA0,
    NodeNext                   = 0x10,
}

task.spawn(function()
    pcall(function()
        local raw = httpget("https://offsets.imtheo.lol/Offsets.json")
        if raw and #raw > 100 then
            local data = game:GetService("HttpService"):JSONDecode(raw)
            if data and data.Offsets then
                local o = data.Offsets
                if o.Misc and o.Misc.AnimationId then MemoryOffsets.AnimationId = o.Misc.AnimationId end
                if o.Instance and o.Instance.ClassDescriptor then MemoryOffsets.ClassDescriptor = o.Instance.ClassDescriptor end
                if o.Instance and o.Instance.ClassName then MemoryOffsets.ClassDescriptorToClassName = o.Instance.ClassName end
                if o.Instance and o.Instance.Name then MemoryOffsets.Name = o.Instance.Name end
                if o.AnimationTrack and o.AnimationTrack.TimePosition then MemoryOffsets.TimePosition = o.AnimationTrack.TimePosition end
                if o.AnimationTrack and o.AnimationTrack.Animation then MemoryOffsets.Animation = o.AnimationTrack.Animation end
                if o.Animator and o.Animator.ActiveAnimations then MemoryOffsets.ActiveAnimations = o.Animator.ActiveAnimations end
                logDebug(string.format("Memory offsets synchronized dynamically! ActiveAnimations: 0x%X", MemoryOffsets.ActiveAnimations))
            end
        end
    end)
end)

-- NOTE: pcall(memory_read, ...) instead of pcall(function() ... end): no closure is allocated per read.
local function ReadPointer(address)
    if not address or address <= 4096 then return nil end
    local ok, value = pcall(memory_read, "uintptr", address)
    return (ok and value and value > 4096) and value or nil
end

local function ReadString(address)
    if not address or address <= 4096 then return nil end
    local ok, str = pcall(memory_read, "string", address)
    return (ok and str) and str or nil
end

local function GetClassName(instanceAddress)
    if not instanceAddress or instanceAddress <= 4096 then return "Invalid" end
    local descriptor = ReadPointer(instanceAddress + MemoryOffsets.ClassDescriptor)
    if descriptor then
        local namePtr = ReadPointer(descriptor + MemoryOffsets.ClassDescriptorToClassName)
        return ReadString(namePtr) or "Unknown"
    end
    return "Error"
end

local function GetIdFromTrack(trackAddress)
    local animPtr = ReadPointer(trackAddress + MemoryOffsets.Animation)
    if animPtr and GetClassName(animPtr) == "Animation" then
        local idPtr = ReadPointer(animPtr + MemoryOffsets.AnimationId)
        local idStr = ReadString(idPtr)
        return idStr or "Unknown ID"
    end
    return "N/A"
end

