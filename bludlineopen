local function hideStunTags(from)
    local tags = StunRadar.tags
    for i = from, #tags do
        local t = tags[i]
        if t.vis then
            t.tag.Visible = false
            t.vis = false
            t.text = ""
        end
    end
end

local function renderStunTags()
    local tags = StunRadar.tags
    local count = 0
    if S.bl_stun_en and JutsuRadar.order then
        local order = JutsuRadar.order
        local roots = JutsuRadar.roots
        local near = JutsuRadar.near
        local maxTags = #tags
        local stunSize = S.bl_stun_size or 13
        local lp = Players.LocalPlayer
        local myName = lp and lp.Name

        local maxDist = S.bl_combat_dist or 400
        for i = 1, #order do
            if count >= maxTags then break end
            local pn = order[i]
            local d = near[pn]
            if not d or d > maxDist then break end
            local isSelf = (myName and pn == myName) or (lp and pn == lp.Name)
            if isSelf and not S.bl_stun_self then
                -- skip self
            else
                local root = roots[pn]
                if root then
                    local entry = StunRadar.cache[pn]
                    if not entry or (rNow - (StunRadar.cacheAt[pn] or 0)) > 8.0 then
                        local rsSettings = JutsuRadar.rsSettingsCache or game:GetService("ReplicatedStorage"):FindFirstChild("Settings")
                        local f = rsSettings and rsSettings:FindFirstChild(pn)
                        entry = {
                            block   = f and f:FindFirstChild("Blocking"),
                            hyper   = f and (f:FindFirstChild("HyperArmour") or f:FindFirstChild("HyperArmor")),
                            stun    = f and f:FindFirstChild("Stunned"),
                            parry   = f and (f:FindFirstChild("ParryStun") or f:FindFirstChild("Parried")),
                            knock   = f and f:FindFirstChild("Knocked"),
                            grip    = f and (f:FindFirstChild("BeingGripped") or f:FindFirstChild("Gripped")),
                        }
                        StunRadar.cache[pn] = entry
                        StunRadar.cacheAt[pn] = rNow
                    end

                    local isBlocking, isHyper, isStunned, isParried, isKnocked, isGripped = false, false, false, false, false, false

                    if entry.block then
                        local ok, v = BX.get(entry.block)
                        if ok and v == true then isBlocking = true end
                    end
                    if entry.hyper then
                        local ok, v = BX.get(entry.hyper)
                        if ok and v == true then isHyper = true end
                    end
                    if entry.stun then
                        local ok, v = BX.get(entry.stun)
                        if ok and v == true then isStunned = true end
                    end
                    if entry.parry then
                        local ok, v = BX.get(entry.parry)
                        if ok and v == true then isParried = true end
                    end
                    if entry.knock then
                        local ok, v = BX.get(entry.knock)
                        if ok and v == true then isKnocked = true end
                    end
                    if entry.grip then
                        local ok, v = BX.get(entry.grip)
                        if ok and v == true then isGripped = true end
                    end

                    local parts = {}
                    local tagCol = nil

                    if S.bl_stun_knock and (isKnocked or isGripped) then
                        if isGripped then
                            parts[#parts + 1] = "[BEING GRIPPED]"
                            tagCol = BX.RGB(255, 45, 45)
                        else
                            parts[#parts + 1] = "[KNOCKED]"
                            tagCol = BX.RGB(255, 60, 60)
                        end
                    else
                        if S.bl_stun_hit then
                            if isParried then
                                parts[#parts + 1] = "[PARRIED]"
                                tagCol = tagCol or BX.RGB(255, 230, 50)
                            elseif isStunned then
                                parts[#parts + 1] = "[STUNNED]"
                                tagCol = tagCol or BX.RGB(255, 225, 45)
                            end
                        end
                        if S.bl_stun_hyper and isHyper then
                            parts[#parts + 1] = "[HYPERARMOR]"
                            tagCol = tagCol or BX.RGB(255, 155, 0)
                        end
                        if S.bl_stun_block and isBlocking then
                            parts[#parts + 1] = "[BLOCKING]"
                            if isHyper then
                                tagCol = BX.RGB(255, 175, 50)
                            else
                                tagCol = tagCol or BX.RGB(60, 210, 255)
                            end
                        end
                    end

                    if #parts > 0 and tagCol then
                        local label = table.concat(parts, " ")
                        local okP, rPos = BX.pos(root)
                        if okP and isValidVec3(rPos) then
                            local okS, sp, onScreen = pcall(WorldToScreen, rPos)
                            if okS and onScreen and isValidVec2(sp) then
                                local dist = (rCamPos - rPos).Magnitude
                                local rawH = (5.5 / (max(dist, 1) * rTan)) * rVpH
                                if isValidNum(rawH) then
                                    local h = clamp(floor(rawH), 16, 450)
                                    count = count + 1
                                    local t = tags[count]

                                    if t.text ~= label then
                                        t.tag.Text = label
                                        t.text = label
                                    end
                                    if t.col ~= tagCol then
                                        t.tag.Color = tagCol
                                        t.col = tagCol
                                    end
                                    if t.size ~= stunSize then
                                        t.tag.Size = stunSize
                                        t.size = stunSize
                                    end

                                    local curOff = tagOffsets[pn] or 20
                                    local stunStep = math.floor(stunSize + 6)
                                    tagOffsets[pn] = curOff + stunStep
                                    local x, y = floor(sp.X), floor(sp.Y - floor(h * 0.5) - curOff)
                                    if t.x ~= x or t.y ~= y then
                                        t.x = x; t.y = y
                                        t.tag.Position = Vector2.new(x, y)
                                    end
                                    if not t.vis then
                                        t.tag.Visible = true
                                        t.vis = true
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    hideStunTags(count + 1)
end

