-- Shadow visibility flags: we never READ .Visible from a Drawing; we remember what we last
-- wrote and only write on change.
local function setVis(s, key, want)
    local vis = s.vis
    if vis[key] ~= want then
        s[key].Visible = want
        vis[key] = want
    end
end

local function hideMobSlot(s)
    if not s or not s.isShown then return end
    s.isShown = false
    setVis(s, "box", false)
    setVis(s, "barBg", false)
