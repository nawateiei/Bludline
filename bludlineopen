-- In-memory / Console Debug Logger (rate-limited, zero disk-I/O stutter)
local lastLogMsg, lastLogAt = "", -100
local function logDebug(msg, force)
    msg = tostring(msg)
    local now = os.clock()
    if not force then
        if (now - lastLogAt) < 1.0 then return end
        if msg == lastLogMsg and (now - lastLogAt) < 10 then return end
    end
    lastLogMsg = msg
    lastLogAt = now
    warn("[Bloodline] " .. msg)
end

-- IEEE-754 Validation Helpers
local function isValidNum(n)
    return type(n) == "number" and n == n and n > -1e9 and n < 1e9
end

local function isValidVec2(v)
    return v and isValidNum(v.X) and isValidNum(v.Y)
end

local function isValidVec3(v)
    return v and isValidNum(v.X) and isValidNum(v.Y) and isValidNum(v.Z)
end

