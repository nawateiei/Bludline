local sliceStart = 0
local function budgetYield()
    if (os.clock() - sliceStart) > FRAME_BUDGET then
        BX.beatDet = os.clock()
        task.wait(0.015)
        sliceStart = os.clock()
    end
end

-- Create / refresh a jutsu cast shown above a head. The label string is built once here.
function setCast(key, skill, ttl, root, who)
    local now = os.clock()
    local lp = Players.LocalPlayer
    local isSelf = (who and lp and who == lp.Name)
    local prefix = isSelf and "[SELF] " or ""
    local c = JutsuRadar.activeCasts[key]
    if c and c.skill == skill then
        local exp = now + ttl
        if exp > c.expireTime then c.expireTime = exp end
        if root then c.root = root end
        if who then c.who = who end
    else
        JutsuRadar.activeCasts[key] = {
            skill = skill, label = prefix .. "[" .. tostring(skill) .. "]",
            expireTime = now + ttl, root = root, who = who, isSelf = isSelf,
        }
    end
end

local function readCooldownValue(s) return s.Value end

local function rootOf(char)
    return char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))
end

local function nearLess(a, b)
    local da = (JutsuRadar.near and JutsuRadar.near[a]) or 1e9
    local db = (JutsuRadar.near and JutsuRadar.near[b]) or 1e9
    if da ~= da then da = 1e9 end
    if db ~= db then db = 1e9 end
    return da < db
end

-- Own player list: roots + distances + distance-sorted order + pruning of per-player caches
local lastPlayerRefresh = -100
local function refreshPlayers(now)
    if (now - lastPlayerRefresh) < PLAYER_REFRESH then return end
    lastPlayerRefresh = now

    local lp = Players.LocalPlayer
    local myPos = lastMyPos
    local lpRoot = rootOf(lp and lp.Character)
    if lpRoot then
        local okP, p = pcall(getPosOf, lpRoot)
        if okP and isValidVec3(p) then myPos = p end
    end

    local roots, near, names, order = {}, {}, {}, {}
    local list = Players:GetPlayers()
    for i = 1, #list do
        local p = list[i]
        if p then
            local pn = tostring(p.Name or "")
            names[pn] = true
            if p ~= lp or S.bl_jutsu_self or S.bl_sub_self or S.bl_iframe_self or S.bl_mode_self or S.bl_stun_self then
                local root = rootOf(p.Character)
                if root then
                    local okR, rp = pcall(getPosOf, root)
                    if okR and isValidVec3(rp) then
                        local d = (myPos - rp).Magnitude
                        local maxCombatDist = S.bl_combat_dist or 400
                        if d == d and (d <= maxCombatDist or p == lp) then
                            roots[pn] = root
                            near[pn] = d
                            order[#order + 1] = pn
                        end
                    end
                end
            end
        end
    end
    JutsuRadar.roots = roots
    JutsuRadar.near  = near
    table.sort(order, nearLess)
    JutsuRadar.order = order

    -- Prune. lastCD is only dropped when a player leaves the server so baseline is never lost
    for n in pairs(JutsuRadar.lastCD) do
        if not names[n] then JutsuRadar.lastCD[n] = nil end
    end
    for n in pairs(JutsuRadar.skillLists) do
        if not names[n] then JutsuRadar.skillLists[n] = nil end
    end
    for n in pairs(JutsuRadar.csCache) do
        if not names[n] then
            JutsuRadar.csCache[n] = nil
            JutsuRadar.csCacheAt[n] = nil
            JutsuRadar.csMiss[n] = nil
        end
    end
    for n in pairs(SubRadar.cache) do
        if not names[n] then
            SubRadar.cache[n] = nil
            SubRadar.cacheAt[n] = nil
            SubRadar.lastVal[n] = nil
            SubRadar.expiresAt[n] = nil
            SubRadar.miss[n] = nil
        end
    end
    for n in pairs(IFrameRadar.cache) do
        if not names[n] then
            IFrameRadar.cache[n] = nil
            IFrameRadar.cacheAt[n] = nil
        end
    end
    for n in pairs(ModeRadar.cache) do
        if not names[n] then
            ModeRadar.cache[n] = nil
            ModeRadar.cacheAt[n] = nil
        end
    end
    for n in pairs(StunRadar.cache) do
        if not names[n] then
            StunRadar.cache[n] = nil
            StunRadar.cacheAt[n] = nil
        end
    end
end

local function refreshCooldownMap(cdFolder, now)
    if (now - JutsuRadar.cdMapAt) < 3 then return end
    JutsuRadar.cdMapAt = now
    local map = {}
    local kids = cdFolder:GetChildren()
    for i = 1, #kids do
        local f = kids[i]
        if f then map[f.Name] = f end
    end
    JutsuRadar.cdMap = map
end

local function skillListFor(pName, pFolder, now)
    local rec = JutsuRadar.skillLists[pName]
    local vals = pFolder:GetChildren()
    if rec and rec.folder == pFolder and #vals == #rec.vals and (now - rec.at) < 1.0 then
        return rec
    end
    local names = {}
    for j = 1, #vals do names[j] = vals[j].Name end
    rec = { folder = pFolder, at = now, vals = vals, names = names }
    JutsuRadar.skillLists[pName] = rec
    return rec
end

local function checkPlayerCooldowns(pName, rec)
    local pCD = JutsuRadar.lastCD[pName]
    local baselineOnly = false
    if not pCD then
        pCD = {}
        JutsuRadar.lastCD[pName] = pCD
        baselineOnly = true     -- first poll after player is registered: just remember existing values
    end
    local vals, names = rec.vals, rec.names
    local root = JutsuRadar.roots[pName]
    for j = 1, #vals do
        local ok, cur = pcall(readCooldownValue, vals[j])
        if ok and type(cur) == "number" then
            local sName = names[j]
            local old = pCD[sName]
            if old ~= nil then
                if cur > old + 0.05 then
                    setCast(pName, sName, 2.5, root, pName)
                    pCD[sName] = cur
                elseif cur < old then
                    pCD[sName] = cur
                end
            else
                pCD[sName] = cur
                if not baselineOnly then
                    -- Brand new skill child created in Cooldowns while player is active:
                    -- In Bloodline, this happens when the player casts this jutsu for the first time!
                    setCast(pName, sName, 2.5, root, pName)
                end
            end
        end
        if j % 8 == 0 then budgetYield() end
    end
end

local function checkPlayerCurrentSkill(pName, now)
    local cs = JutsuRadar.csCache[pName]
    if cs and (now - (JutsuRadar.csCacheAt[pName] or 0)) > CS_RECHECK then
        cs = nil
        JutsuRadar.csCache[pName] = nil
    end
    if not cs then
        if (now - (JutsuRadar.csMiss[pName] or -100)) < 2 then return end
        JutsuRadar.csMiss[pName] = now
        local rsSettings = JutsuRadar.rsSettingsCache
        if not rsSettings then
            rsSettings = game:GetService("ReplicatedStorage"):FindFirstChild("Settings")
            JutsuRadar.rsSettingsCache = rsSettings
        end
        local f = rsSettings and rsSettings:FindFirstChild(pName)
        cs = f and f:FindFirstChild("CurrentSkill")
        if not cs then return end
        JutsuRadar.csCache[pName] = cs
        JutsuRadar.csCacheAt[pName] = now
    end
    local ok, v = pcall(getValue, cs)
    if not ok then
        JutsuRadar.csCache[pName] = nil
        return
    end
    local skill = tostring(v or "")
    if skill ~= "" and skill ~= "None" then
        setCast(pName, skill, 2.0, JutsuRadar.roots[pName], pName)
    end
end

local function checkMobSkill(c, now)
    local a = c.addr
    local aux = a and mobAux[a]
    if not aux then
        aux = {}
        if a then mobAux[a] = aux end
    end

    if aux.skillVal and (now - (aux.skillAt or 0)) > CS_RECHECK then aux.skillVal = nil end
    if not aux.skillVal then
        if (now - (aux.missAt or -100)) < 1.5 then return end
        aux.missAt = now
        local settings = c.model:FindFirstChild("Settings")
        aux.skillVal = settings and settings:FindFirstChild("CurrentSkill")
        aux.skillAt = now
        if not aux.skillVal then return end
    end

    local ok, v = pcall(getValue, aux.skillVal)
    if not ok then
        aux.skillVal = nil
        return
    end
    local skill = tostring(v or "")
    if skill ~= "" and skill ~= "None" then
        setCast(c.name .. "#" .. tostring(a or 0), skill, 2.0, c.root, nil)
    end
end

-- ---- sections, each wrapped in its own pcall by updateActiveCasts ----
local eligBuf, cdCursor = {}, 0
local function sectionCooldowns(now)
    if not JutsuRadar.cdFolderCache then
        JutsuRadar.cdFolderCache = game:GetService("ReplicatedStorage"):FindFirstChild("Cooldowns")
    end
    local cdFolder = JutsuRadar.cdFolderCache
    if not cdFolder then return end

    local okMap = pcall(refreshCooldownMap, cdFolder, now)
    if not okMap then JutsuRadar.cdFolderCache = nil; return end
    local map = JutsuRadar.cdMap
    if not map then return end

    local order, near = JutsuRadar.order, JutsuRadar.near
    if not order then return end
    local maxDist = S.bl_combat_dist or 400
    local n = 0
    for i = 1, #order do
        local pn = order[i]
        local d = near[pn]
        if not d or d > maxDist or n >= CD_PLAYERS_MAX then break end
        n = n + 1
        eligBuf[n] = pn
    end
    for i = #eligBuf, n + 1, -1 do eligBuf[i] = nil end
    if n == 0 then return end

    local per = (n < CD_PER_CYCLE) and n or CD_PER_CYCLE
    for _ = 1, per do
        cdCursor = (cdCursor % n) + 1
        local pn = eligBuf[cdCursor]
        local pFolder = pn and map[pn]
        if pFolder then
            local okR, rec = pcall(skillListFor, pn, pFolder, now)
            if okR and rec then
                pcall(checkPlayerCooldowns, pn, rec)
            end
        end
        budgetYield()
    end
end

local function sectionCurrentSkill(now, far)
    local order, near = JutsuRadar.order, JutsuRadar.near
    if not order then return end
    local maxDist = S.bl_combat_dist or 400
    local nearDist = maxDist * 0.5
    for i = 1, #order do
        local pn = order[i]
        local d = near[pn]
        if not d or d > maxDist then break end
        if d <= nearDist or far then
            pcall(checkPlayerCurrentSkill, pn, now)
            budgetYield()
        end
    end
end

local function sectionMobs(now)
    if not S.bl_jutsu_mobs then return end
    local cands = mobCands
    local checked = 0
    for i = 1, #cands do
        if checked >= JUTSU_MOB_MAX then break end
        local c = cands[i]
        if c.dist > JUTSU_MOB_RANGE then break end
        if c.model then
            checked = checked + 1
            pcall(checkMobSkill, c, now)
            budgetYield()
        end
    end
end

local function sectionPurge(now)
    for key, cast in pairs(JutsuRadar.activeCasts) do
        if now >= cast.expireTime then
            JutsuRadar.activeCasts[key] = nil
        end
    end
end

local tickCount = 0
local function updateActiveCasts()
    local combatActive = S.bl_jutsu_tag or S.bl_sub_en or S.bl_iframe_en or S.bl_mode_en or S.bl_stun_en
    if not combatActive then
        if next(JutsuRadar.activeCasts) then JutsuRadar.activeCasts = {} end
        return
    end

    tickCount = tickCount + 1
    local far = (tickCount % 4 == 0)
    local now = os.clock()

    local ok0, e0 = pcall(refreshPlayers, now)
    if not ok0 then logDebug("Jutsu players error: " .. tostring(e0)) end

    if S.bl_jutsu_tag then
        local ok2, e2 = pcall(sectionCurrentSkill, now, far)
        if not ok2 then logDebug("Jutsu skill error: " .. tostring(e2)) end
        if S.bl_jutsu_cd then
            local ok1, e1 = pcall(sectionCooldowns, os.clock())
            if not ok1 then logDebug("Jutsu cooldown error: " .. tostring(e1)) end
        end
        if tickCount % 3 == 0 then
            local ok3, e3 = pcall(sectionMobs, os.clock())
            if not ok3 then logDebug("Jutsu mob error: " .. tostring(e3)) end
        end
    else
        if next(JutsuRadar.activeCasts) then JutsuRadar.activeCasts = {} end
    end
    sectionPurge(os.clock())
end

local detTok = 0
BX.startDet = function()
detTok = detTok + 1
local myTok = detTok
task.spawn(function()
    while alive() and detTok == myTok do
        BX.beatDet = os.clock()
        sliceStart = os.clock()
        if alive() then
            local ok, err = pcall(updateActiveCasts)
            if not ok then logDebug("Jutsu detector error: " .. tostring(err)) end
        end

        local delay = CYCLE_OFF
        if S.bl_jutsu_tag or S.bl_sub_en or S.bl_iframe_en or S.bl_mode_en or S.bl_stun_en then
            if (JutsuRadar.order and JutsuRadar.order[1]) or (S.bl_jutsu_mobs and mobCands[1]) then
                delay = CYCLE_ACTIVE
            else
                delay = CYCLE_IDLE
            end
        end
        task.wait(delay + BX.backoff * 4)
    end
end)
end
BX.startDet()
end

-- ============================================================
--  LOOP B: TIME-SLICED COLLECTOR
--  Wrapped in do ... end so its locals are released when the block closes (keeps the main
--  chunk under the 200-local limit). The renderer only reads the published tables.
-- ============================================================
do
local RARE_FILTER_KEY = {
    ["Life Up Fruit"]          = "bl_r_life",
    ["Fruit of Forgetfulness"] = "bl_r_forg",
    ["Chakra Fruit"]           = "bl_r_chak",
    ["Scrolls"]                = "bl_r_scrl",
    ["Rings"]                  = "bl_r_rings",
    ["Schematics"]             = "bl_r_schem",
    ["Eyes"]                   = "bl_r_eyes",
}
local COMMON_FRUITS = {
    ["Apple"] = true, ["Alluring Apple"] = true, ["Banana"] = true,
    ["Orange"] = true, ["Pear"] = true, ["Mango"] = true,
}
local COMBAT_NAME_HINTS = {
    "Bandit", "Guard", "Manda", "Snake", "Rogue", "Zetsu", "Boss", "Lavarossa",
    "The Barbarian", "Barbarit", "Clone", "Dummy", "Instructor Clone", "Clay Runner",
    "Runner", "Cratos", "Tairock",
}

-- Which UI toggle controls this item? nil = always allowed (rare item with no dedicated toggle)
local function itemSettingKey(name, rareInfo)
    if rareInfo then
        return RARE_FILTER_KEY[rareInfo.filter]
    end
    if name:find("Bells") then return "f_bells" end
    if name:find("Gloweed") or name:find("Glowweed") then return "f_gloweed" end
    if name:find("Seaweed") or name:find("Weed") then return "f_seaweed" end
    if COMMON_FRUITS[name] then return "f_common_fruit" end
    return "f_other"
end

local function hasCombatHint(name)
    for i = 1, #COMBAT_NAME_HINTS do
        if string.find(name, COMBAT_NAME_HINTS[i], 1, true) then return true end
    end
    return false
end

local negName, negUntil = {}, {}
local function ignoreObj(addr, name, ttl)
    negName[addr]  = name
    negUntil[addr] = os.clock() + ttl
end
local function longTTL()
    return NEG_TTL_BASE + math.random() * NEG_TTL_JITTER
end

-- Per-pass state (assigned at the start of every pass, read by processObject)
local P_now, P_myPos, P_myName = 0, Vector3.new(0, 0, 0), ""
local P_playerNames, P_playerChars = {}, {}
local P_freshCands, P_freshMobs, P_freshNPCs, P_freshCorrupt, P_freshRifts, P_freshItems = {}, {}, {}, {}, {}, {}
local P_liveItemAddrs, P_liveBeastKeys, P_livePumpkinKeys, P_liveRiftAddrs = {}, {}, {}, {}
local P_freshBeastTamer = nil
local P_needMobs = false

local function findItemPos(obj, cname)
    local p = obj.Position
    if not p and cname == "Model" then
        local part = obj.PrimaryPart or obj:FindFirstChild("Handle") or obj:FindFirstChildOfClass("Part") or obj:FindFirstChildOfClass("MeshPart")
        p = part and part.Position
    end
    return p
end

local function addWorldBoss(obj, objName, addr)
    if not P_needMobs then return end
    local root = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso") or obj:FindFirstChildOfClass("BasePart")
    local hum = obj:FindFirstChildOfClass("Humanoid")
    if root and hum and isAliveHum(hum) then
        local okP, rp = pcall(getPosOf, root)
        local d = (okP and isValidVec3(rp)) and (P_myPos - rp).Magnitude or 1e9
        if d ~= d then d = 1e9 end
        P_freshCands[#P_freshCands + 1] = {
            name = objName, model = obj, root = root, hum = hum, dist = d, addr = addr,
        }
    end
end

local function processRift(rift)
    if not rift then return end
    local rName = tostring(rift.Name or "")
    if rName == "Unstable Rift" or string.find(rName, "Unstable Rift") then return end

    local p = nil
    if rift:IsA("BasePart") then
        local ok, pos = pcall(function() return rift.Position end)
        if ok and pos then p = pos end
    elseif rift:IsA("Model") then
        local bp = rift.PrimaryPart or rift:FindFirstChildWhichIsA("BasePart")
        if bp then
            local ok, pos = pcall(function() return bp.Position end)
            if ok and pos then p = pos end
        end
    end
    if not p or not isValidVec3(p) then return end

    local dist = (P_myPos - p).Magnitude
    local addr = rift.Address or tostring(p)
    local isSasuke = (string.find(rName, "Sasuke") ~= nil or string.find(rName, "Portal") ~= nil)

    P_freshRifts[#P_freshRifts + 1] = {
        inst = rift,
        pos = p,
        dist = dist,
        name = rName,
        addr = addr,
        isSasuke = isSasuke,
    }
    P_liveRiftAddrs[addr] = true
    if not notifiedRifts[addr] then
        notifiedRifts[addr] = true
        if S.bl_rift_notify then
            notify("HALLOWEEN EVENT ALERT!", string.format("%s spawned! [%dm away]", rName, floor(dist)), 10)
        end
    end
end

-- Helper to identify valid items without calling FindFirstChild on random objects
local function isLikelyItemName(n)
    if not n or n == "" or n == "Part" or n == "Model" or n == "MeshPart" then return false end
    if KNOWN_ITEMS[n] or RARE_ITEMS[n] then return true end
    if string.find(n, "Gem", 1, true) or string.find(n, "Scroll", 1, true)
        or string.find(n, "Ring", 1, true) or string.find(n, "Fruit", 1, true)
        or string.find(n, "Schematic", 1, true) or string.find(n, "Eyes", 1, true)
        or string.find(n, "Bells", 1, true) or n == "Seaweed" or n == "Gloweed"
        or n == "Glowweed" or n == "Candy" or n == "Extraction Spoon"
        or string.find(n, "Armor", 1, true)
        or string.find(n, "Sword", 1, true) or string.find(n, "Katana", 1, true)
        or string.find(n, "Blade", 1, true) or string.find(n, "Potion", 1, true)
        or string.find(n, "Drop", 1, true) then
        return true
    end
    return false
end

-- Classifies ONE Workspace child.
-- Hardened against freed/despawned instances to prevent C++ memory walker deadlocks in Matcha.
local function processObject(obj)
    if not obj then return end

    -- 1. Liveness check: Reading ClassName from a freed instance returns "" or fails
    local okCls, cname = pcall(function() return obj.ClassName end)
    if not okCls or type(cname) ~= "string" or #cname == 0 or cname == "" then
        return -- Freed/corrupted instance, NEVER touch!
    end

    -- Fast reject non-candidate classes immediately
    if cname == "WedgePart" or cname == "CornerWedgePart"
        or cname == "TrussPart" or cname == "Terrain" or cname == "Camera"
        or cname == "UnionOperation" or cname == "Folder" then
        return
    end

    -- 2. Liveness check: Reading Name from a freed instance returns "" or fails
    local okName, objName = pcall(function() return obj.Name end)
    if not okName or type(objName) ~= "string" or #objName == 0 or objName == "" then
        return -- Freed/corrupted instance, NEVER touch!
    end

    -- Fast reject generic static parts and combat slash/hitbox parts
    if objName == "Part" or STATIC_PROP_NAMES[objName] or COMMON_RINGS[objName] then
        return
    end

    -- 3. Loose Sasuke Portal / Event Portal in Workspace
    if string.find(objName, "Sasuke", 1, true) or (string.find(objName, "Portal", 1, true) and objName ~= "Portal" and objName ~= "Portal2" and objName ~= "ShukakuPortal") then
        if cname == "MeshPart" or cname == "Model" or cname == "Part" then
            pcall(processRift, obj)
            return
        end
    end

    -- Fast reject all remaining plain Part instances (not portals, not items)
    if cname == "Part" and not isLikelyItemName(objName) then
        return
    end

    -- Skip players (handled via Players:GetPlayers())
    if P_playerNames[objName] then return end

    local okAddr, addr = pcall(function() return obj.Address end)
    if not okAddr or not addr then return end

    local nu = negUntil[addr]
    if nu and nu > P_now and negName[addr] == objName then return end

    local isModel = (cname == "Model")

    -- 4. SPECIAL EVENT: Beast Tamer
    if isModel and string.find(string.lower(objName), "beast tamer", 1, true) then
        local root = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso") or obj:FindFirstChildOfClass("BasePart")
        if root then
            local okP, p = pcall(getPosOf, root)
            if okP and isValidVec3(p) then
                P_freshBeastTamer = { model = obj, root = root, pos = p, key = addr }
                P_liveBeastKeys[addr] = true
                if not notifiedBeastTamer[addr] then
                    notifiedBeastTamer[addr] = true
                    if S.bl_ev_beast_tamer then
                        notify("EVENT ALERT!", string.format("Beast Tamer has spawned! [%dm away]", floor((P_myPos - p).Magnitude)), 10)
                    end
                end
            end
        end
        return
    end

    -- 5. CORRUPTED POINT & EVENT CORRUPTION POINT (Pumpkin / PumpkinPoint / CorruptedPoint)
    local isCorruptCandidate = isModel and (
        objName == "CorruptedPoint" or objName == "PumpkinPoint"
        or string.find(objName, "Pumpkin", 1, true) ~= nil
        or string.find(objName, "Corrupt", 1, true) ~= nil
    )
    if isCorruptCandidate then
        local dest = obj:FindFirstChild("Destroyed")
        local isDestroyed = dest and dest.Value == true
        if not (S.bl_corrupt_dest and isDestroyed) then
            local main = obj:FindFirstChild("Main") or obj:FindFirstChild("InnerPool") or obj:FindFirstChildOfClass("BasePart")
            if main then
                local okP, p = pcall(getPosOf, main)
                if okP and isValidVec3(p) then
                    local isPumpkin = (string.find(objName, "Pumpkin", 1, true) ~= nil)
                    local hpVal = obj:FindFirstChild("Health")
                    local hpNum = (hpVal and hpVal:IsA("ValueBase")) and hpVal.Value or nil
                    P_freshCorrupt[#P_freshCorrupt + 1] = {
                        model = obj,
                        hpVal = hpVal,
                        hp = hpNum,
                        pos = p,
                        isDestroyed = isDestroyed,
                        dist = (P_myPos - p).Magnitude,
                        name = isPumpkin and "Pumpkin Point" or "Corrupted Point",
                        isPumpkin = isPumpkin,
                    }
                    if isPumpkin then
                        P_livePumpkinKeys[addr] = true
                        if not notifiedPumpkin[addr] then
                            notifiedPumpkin[addr] = true
                            if S.bl_ev_pumpkin then
                                notify("EVENT ALERT!", string.format("Pumpkin Point! [%dm away]", floor((P_myPos - p).Magnitude)), 8)
                            end
                        end
                    end
                end
            end
        end
        return
    end

    -- Combat VFX / jewelry props
    if string.find(objName, "Shock", 1, true) or string.find(objName, "ThinRing", 1, true) or string.find(objName, "MovingRing", 1, true) or string.find(objName, "Slash", 1, true) then
        ignoreObj(addr, objName, longTTL())
        return
    end

    -- 6. ITEM DETECTOR (Only runs on objects matching item names/patterns - ZERO blind FindFirstChild calls!)
    if isLikelyItemName(objName) then
        -- Fast reject shop items / cosmetic display models (vendor stock has a 'Buyable' child)
        local okB, buyable = pcall(function() return obj:FindFirstChild("Buyable") end)
        if okB and buyable then
            ignoreObj(addr, objName, longTTL())
            return
        end

        local lname = objName:lower()
        if COMMON_RINGS[objName] or lname == "ring" or lname == "gold ring" or lname == "golden ring"
            or lname == "gold enclosed ring" or lname == "common ring" or lname == "necklace" then
            ignoreObj(addr, objName, longTTL())
            return
        end

        local rareInfo = RARE_ITEMS[objName]
        if not rareInfo then
            if string.find(objName, "Schematic", 1, true) then
                rareInfo = { color = Color3.fromRGB(100, 190, 255), label = "★ " .. objName .. " ★", filter = "Schematics" }
            elseif string.find(objName, " Eyes", 1, true) then
                rareInfo = { color = Color3.fromRGB(255, 45, 75), label = "★ " .. objName .. " ★", filter = "Eyes" }
            end
        end

        local okPos, pos = pcall(findItemPos, obj, cname)
        if okPos and isValidVec3(pos) then
            if rareInfo then
                P_liveItemAddrs[addr] = true
                if not notifiedItems[addr] then
                    notifiedItems[addr] = true
                    if S.bl_rare_notif then
                        notify("Rare Item Alert!", string.format("%s spawned near you! [%dm away]", rareInfo.label, floor((P_myPos - pos).Magnitude)), 8)
                    end
                end
            end
            P_freshItems[#P_freshItems + 1] = {
                obj      = obj,
                name     = objName,
                display  = rareInfo and rareInfo.label or objName,
                pos      = pos,
                isRare   = (rareInfo ~= nil),
                rareInfo = rareInfo,
                key      = itemSettingKey(objName, rareInfo),
                dist     = (P_myPos - pos).Magnitude,
            }
        else
            ignoreObj(addr, objName, 1.5)
        end
        return
    end

    -- 7. MODELS: combat mobs, town NPCs, world bosses
    if not isModel or objName:sub(1, 4) == "Tree" or objName:sub(1, 7) == "Caravan" then
        ignoreObj(addr, objName, longTTL())
        return
    end

    local tagObj = obj:FindFirstChild("NPC")
    if not tagObj then
        if obj:FindFirstChild("WorldBoss") then
            addWorldBoss(obj, objName, addr)   -- positive: re-collected every pass, never cached away
        else
            ignoreObj(addr, objName, longTTL())
        end
        return
    end

    local hum  = obj:FindFirstChildOfClass("Humanoid")
    local root = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso") or obj:FindFirstChild("UpperTorso")
    if not (hum and root) then
        ignoreObj(addr, objName, 1.5)
        return
    end

    local okHp, hp = pcall(getHealth, hum)
    if not (okHp and isValidNum(hp) and hp > 0) then
        ignoreObj(addr, objName, 1.0)
        return
    end

    local okR, rp = pcall(getPosOf, root)
    if not (okR and isValidVec3(rp)) then
        ignoreObj(addr, objName, 1.0)
        return
    end

    local tagVal = tostring(tagObj.Value or "")
    local maxHp  = hum.MaxHealth
    if not isValidNum(maxHp) or maxHp <= 0 then maxHp = 100 end

    local hintCombat = hasCombatHint(objName)
    local isKnownFriendly = (tagVal == "Dialog")
        or FRIENDLY_NPCS[objName]
        or (maxHp <= 100 and tagVal ~= "Combat"
            and not string.find(objName, "Bandit", 1, true)
            and not string.find(objName, "Guard", 1, true)
            and not string.find(objName, "Clone", 1, true))

    local isCombat = not isKnownFriendly and (
        tagVal == "Combat" or hintCombat or maxHp > 100 or hp < maxHp
    )

    local cleanName = objName
    if S.bl_mob_clean then cleanName = string.gsub(objName, "%d+$", "") end

    local d = (P_myPos - rp).Magnitude
    if d ~= d then d = 1e9 end

    if isCombat then
        if P_needMobs then
            P_freshCands[#P_freshCands + 1] = {
                name = cleanName, model = obj, root = root, hum = hum, dist = d, addr = addr,
            }
        end
        P_freshMobs[#P_freshMobs + 1] = { root = root, hum = hum, name = cleanName, maxHp = maxHp, dist = d }
    else
        P_freshNPCs[#P_freshNPCs + 1] = { root = root, name = cleanName, dist = d }
    end
end

-- Chakra Sense scanner
local cdFolderCache = nil
local function scanChakra()
    local freshChakra = {}
    if S.bl_cs_en then
        if not cdFolderCache then
            cdFolderCache = game:GetService("ReplicatedStorage"):FindFirstChild("Cooldowns")
        end
        local cdFolder = cdFolderCache
        if cdFolder then
            local cdList = cdFolder:GetChildren()
            for i = 1, #cdList do
                local pFolder = cdList[i]
                local csVal = pFolder and pFolder:FindFirstChild("Chakra Sense")
                if csVal then
                    local pName = pFolder.Name
                    local char = (P_playerChars and P_playerChars[pName])
                    if not char then
                        local pObj = Players:FindFirstChild(pName)
                        char = pObj and pObj.Character
                    end
                    local torso = char and (char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso"))
                    local root = char and char:FindFirstChild("HumanoidRootPart")
                    local isCasting = (char and (char:FindFirstChild("ChakraSense") or (torso and torso:FindFirstChild("ChakraSense")) or (root and root:FindFirstChild("ChakraSense"))) ~= nil) or false

                    freshChakra[#freshChakra + 1] = { name = pName, isCasting = isCasting }

                    if not notifiedChakraUsers[pName] then
                        notifiedChakraUsers[pName] = true
                        if S.bl_cs_notify then
                            notify("Chakra Sense Detected!", string.format("%s has Chakra Sense in loadout!", pName), 7)
                        end
                    end

                    if isCasting then
                        if not lastChakraCastState[pName] then
                            lastChakraCastState[pName] = true
                            if S.bl_cs_use_notify then
                                notify("CHAKRA SENSE ACTIVE!", string.format("%s is using Chakra Sense right now!", pName), 6)
                            end
                        end
                    else
                        lastChakraCastState[pName] = false
                    end
                end
            end
        end
    end

    for pName in pairs(notifiedChakraUsers) do
        local stillHere = (P_playerNames and P_playerNames[pName]) or (Players:FindFirstChild(pName) ~= nil)
        if not stillHere then
            notifiedChakraUsers[pName] = nil
            lastChakraCastState[pName] = nil
        end
    end

    -- Build Chakra Sense HUD strings once per pass
    local n = #freshChakra
    local text, title = "", ""
    if n > 0 then
        local lines = {}
        for i = 1, n do
            local u = freshChakra[i]
            lines[i] = string.format(" %s: %s", u.name, u.isCasting and "[CASTING NOW!]" or "[Idle]")
        end
        text  = table.concat(lines, "\n")
        title = string.format("[Chakra Sense Radar (%d)]", n)
    end
    trackedChakraUsers, trackedChakraText, trackedChakraTitle, trackedChakraCount = freshChakra, text, title, n
end

local function runScanPass()
    if not alive() then return end
    _G.Bloodline_scanPassCount = (_G.Bloodline_scanPassCount or 0) + 1
    local startEpoch = scanEpoch
    refreshSettings()

    local lp = Players.LocalPlayer
    local lpChar = lp and lp.Character
    local lpRoot = lpChar and (lpChar:FindFirstChild("HumanoidRootPart") or lpChar:FindFirstChild("Torso"))
    if lpRoot then
        local okP, p = pcall(getPosOf, lpRoot)
        if okP and isValidVec3(p) then lastMyPos = p end
    end

    P_now        = os.clock()
    P_myPos      = lastMyPos
    P_myName     = lp and lp.Name or ""
    P_playerNames, P_playerChars = {}, {}
    P_freshCands, P_freshMobs, P_freshNPCs, P_freshCorrupt, P_freshRifts, P_freshItems = {}, {}, {}, {}, {}, {}
    P_liveItemAddrs, P_liveBeastKeys, P_livePumpkinKeys, P_liveRiftAddrs = {}, {}, {}, {}
    P_freshBeastTamer = nil

    -- mob candidates are only needed by the jutsu tags above mobs / bosses
    P_needMobs = (S.bl_jutsu_tag and S.bl_jutsu_mobs) and true or false

    -- Players (name filter + character map for Chakra Sense)
    local pList = Players:GetPlayers()
    for i = 1, #pList do
        local p = pList[i]
        if p then
            local pn = tostring(p.Name or "")
            P_playerNames[pn] = true
            P_playerChars[pn] = p.Character
        end
    end

    if not alive() then return end

    -- Time-sliced Workspace walk
    local children = Workspace:GetChildren()
    local total = #children
    local sliceStart = os.clock()
    for i = 1, total do
        if not alive() or scanEpoch ~= startEpoch then return end
        local obj = children[i]
        if obj then
            local okPar, par = pcall(function() return obj.Parent end)
            if okPar and par == Workspace then
                local t = os.clock()
                P_now = t
                local ok = pcall(processObject, obj)
                if not ok then
                    _G.Bloodline_objErrors = (_G.Bloodline_objErrors or 0) + 1
                end
                if (t - sliceStart) > SCAN_SLICE_BUDGET then
                    if scanEpoch ~= startEpoch then return end
                    BX.beatCol = os.clock()
                    task.wait(0.005)
                    if not alive() then return end
                    if scanEpoch ~= startEpoch then return end
                    sliceStart = os.clock()
                end
            end
        end
    end

    -- Player teleported while we were scanning: results are for the wrong place, drop them
    if scanEpoch ~= startEpoch then return end

    -- Include event rifts found by the asynchronous micro-sliced Debris worker
    if S.bl_rift_en and BX.debrisRifts then
        for i = 1, #BX.debrisRifts do
            pcall(processRift, BX.debrisRifts[i])
        end
    end

    -- Sort nearest-first so the small draw pools always get the CLOSEST entities (rare items first)
    table.sort(P_freshMobs, byDist)
    table.sort(P_freshNPCs, byDist)
    table.sort(P_freshCorrupt, byDist)
    table.sort(P_freshRifts, function(a, b)
        if a.isSasuke ~= b.isSasuke then return a.isSasuke end
        return a.dist < b.dist
    end)
    table.sort(P_freshItems, itemLess)
    table.sort(P_freshCands, byDist)
    capList(P_freshNPCs, NPC_POOL_SIZE)
    capList(P_freshCorrupt, CORRUPT_POOL_SIZE)
    capList(P_freshRifts, RIFT_POOL_SIZE)
    capList(P_freshItems, ITEM_LIST_CAP)

    -- Drop per-mob caches of things that no longer exist
    local liveAddrs = {}
    for i = 1, #P_freshCands do
        local a = P_freshCands[i].addr
        if a then liveAddrs[a] = true end
    end
    for a in pairs(mobAux) do
        if not liveAddrs[a] then mobAux[a] = nil end
    end

    -- Housekeeping for notification de-dupe tables
    for a in pairs(notifiedItems) do
        if not P_liveItemAddrs[a] then notifiedItems[a] = nil end
    end
    for k in pairs(notifiedBeastTamer) do
        if not P_liveBeastKeys[k] then notifiedBeastTamer[k] = nil end
    end
    for k in pairs(notifiedPumpkin) do
        if not P_livePumpkinKeys[k] then notifiedPumpkin[k] = nil end
    end
    for k in pairs(notifiedRifts) do
        if not P_liveRiftAddrs[k] then notifiedRifts[k] = nil end
    end
    _G.Bloodline_beastTamerSpawned = (P_freshBeastTamer ~= nil)

    -- Expired negative-cache entries
    local nowc = os.clock()
    for a, t in pairs(negUntil) do
        if t < nowc then negUntil[a] = nil; negName[a] = nil end
    end

    -- PUBLISH (all at once, so the renderer never sees a half-updated world)
    mobCands          = P_freshCands
    trackedMobs       = P_freshMobs
    trackedNPCs       = P_freshNPCs
    trackedCorrupt    = P_freshCorrupt
    trackedRifts      = P_freshRifts
    trackedItems      = P_freshItems
    trackedBeastTamer = P_freshBeastTamer
    drawDirty         = true

    local okC = pcall(scanChakra)
    if not okC then cdFolderCache = nil end
end

local colTok = 0
BX.startCol = function()
    colTok = colTok + 1
    local myTok = colTok
    task.spawn(function()
        while alive() and colTok == myTok do
            BX.beatCol = os.clock()
            local t0 = os.clock()
            local ok, err = pcall(runScanPass)
            if not ok then logDebug("Collector error: " .. tostring(err)) end
            task.wait(SCAN_INTERVAL + BX.backoff * 2)
        end
    end)
end
BX.startCol()

local debTok = 0
BX.startDeb = function()
    debTok = debTok + 1
    local myTok = debTok
    task.spawn(function()
        while alive() and debTok == myTok do
            BX.beatDeb = os.clock()
            if S.bl_rift_en and alive() then
                local deb = Workspace:FindFirstChild("Debris")
                if deb and alive() then
                    local kids = deb:GetChildren()
                    local found = {}
                    local sliceStart = os.clock()
                    for i = 1, #kids do
                        if not alive() or debTok ~= myTok then return end
                        local child = kids[i]
                        if child and alive() then
                            local okN, cName = pcall(function() return child.Name end)
                            if okN and type(cName) == "string" and #cName > 0 and cName ~= "Part" then
                                if string.find(cName, "Sasuke", 1, true) or (string.find(cName, "Portal", 1, true) and cName ~= "Portal" and cName ~= "Portal2" and cName ~= "ShukakuPortal") then
                                    found[#found + 1] = child
                                end
                            end
                        end
                        if (os.clock() - sliceStart) > 0.002 then
                            task.wait(0.008)
                            if not alive() or debTok ~= myTok then return end
                            sliceStart = os.clock()
                        end
                    end
                    if alive() then
                        BX.debrisRifts = found
                    end
                end
            end
            task.wait(0.50)
        end
    end)
end
BX.startDeb()

local csTok = 0
BX.startCs = function()
    csTok = csTok + 1
    local myTok = csTok
    task.spawn(function()
        while alive() and csTok == myTok do
            BX.beatCs = os.clock()
            if S.bl_cs_en and alive() then
                local ok, err = pcall(scanChakra)
                if not ok then cdFolderCache = nil end
            end
            task.wait(0.25)
        end
    end)
end
BX.startCs()
end -- end of collector scope

-- ============================================================
--  LOOP C: RENDERER (RenderStepped)
--  Reads only cached data + live .Position/.Health. No tree lookups, no closures per frame,
--  no Drawing property READS, and a Drawing is only written when its value really changed.
-- ============================================================
local lastCamPos        = nil
local lastRenderClock   = 0
-- MIN_FRAME_TIME is configured dynamically from MAX_RENDER_FPS in settings
local lastSettingsPoll  = 0
local lastDrawSettingsVersion = -1

local drawMobs, drawItems = {}, {}

-- Per-frame values shared with the render helpers
local rNow, rCamPos, rVpH, rTan, rBotX, rBotY = 0, Vector3.new(0, 0, 0), 0, 0, 0, 0

_G.Bloodline_renderFrameCount = 0
_G.Bloodline_lastError = nil

-- value reads are cached for 0.12s (staggered) and capped per frame
function BX.get(inst)
    local rec = BX.vals[inst]
    if rec and ((rNow - rec.at) < 0.12 or BX.reads >= 24) then return rec.ok, rec.v end
    BX.reads = BX.reads + 1
    local ok, v = pcall(getValue, inst)
    if rec then
        rec.ok = ok; rec.v = v; rec.at = rNow
    else
        BX.vals[inst] = { ok = ok, v = v, at = rNow - math.random() * 0.12 }
    end
    return ok, v
end

-- root position is read once per frame, shared by all tag types
function BX.pos(root)
    local p = BX.posCache[root]
    if p ~= nil then return true, p end
    local ok, v = pcall(getPosOf, root)
    if ok and v ~= nil then BX.posCache[root] = v end
    return ok, v
end

-- Write Position / Size / line ends only if they changed since the last write
local function place(s, key, x, y)
    local cache = s.c
    local c = cache[key]
    if not c then c = {}; cache[key] = c end
    if c.x ~= x or c.y ~= y then
        c.x = x; c.y = y
        s[key].Position = Vector2.new(x, y)
    end
end

local function sizeIt(s, key, w, h)
    local cache = s.c
    local c = cache[key]
    if not c then c = {}; cache[key] = c end
    if c.w ~= w or c.h ~= h then
        c.w = w; c.h = h
        s[key].Size = Vector2.new(w, h)
    end
end

local function setLine(s, fx, fy, tx, ty)
    local l = s.line
    if l.fx ~= fx or l.fy ~= fy then
        l.fx = fx; l.fy = fy
        s.tracer.From = Vector2.new(fx, fy)
    end
    if l.tx ~= tx or l.ty ~= ty then
        l.tx = tx; l.ty = ty
        s.tracer.To = Vector2.new(tx, ty)
    end
end

-- Shadow visibility for the loose HUD drawings
local hudState = {}
local function setHud(d, want)
    if hudState[d] ~= want then
        d.Visible = want
        hudState[d] = want
    end
end

local function rebuildDrawLists()
    drawDirty = false
    lastDrawSettingsVersion = settingsVersion

    local bossOnly = S.bl_mob_boss
    local mobs, n = {}, 0
    for i = 1, #trackedMobs do
        local m = trackedMobs[i]
        if not bossOnly or m.maxHp > 500 then
            n = n + 1
            mobs[n] = m
            if n >= MOB_POOL_SIZE then break end
        end
    end
    drawMobs = mobs

    local items, k = {}, 0
    for i = 1, #trackedItems do
        local it = trackedItems[i]
        if it.key == nil or S[it.key] then
            k = k + 1
            items[k] = it
            if k >= ITEM_POOL_SIZE then break end
        end
    end
    drawItems = items
end

-- ---------------- COMBAT MOBS ----------------
local function drawMobEntity(e, m)
    local root, hum = m.root, m.hum
    if not root or not hum then return false end
    local okPar, par = pcall(function() return root.Parent end)
    if not okPar or not par then return false end
    local okPar2, gpar = pcall(function() return par.Parent end)
    if par ~= Workspace and gpar ~= Workspace then return false end

    local ok, rPos, hp = pcall(readMob, m)
    if not ok or not isValidVec3(rPos) or not isValidNum(hp) or hp <= 0 then return false end

    local dist = (rCamPos - rPos).Magnitude
    if dist <= 0.5 then return false end

    local okS, sp, onScreen = pcall(WorldToScreen, rPos)
    if not okS or not onScreen or not isValidVec2(sp) then return false end

    local rawH = (5.5 / (dist * rTan)) * rVpH
    if not isValidNum(rawH) then return false end

    local h = clamp(floor(rawH), 16, 450)
    local w = clamp(floor(h * 0.55), 8, 300)
    local boxX = floor(sp.X - floor(w * 0.5))
    local boxY = floor(sp.Y - floor(h * 0.5))
    local maxHp = (m.maxHp and m.maxHp > 0) and m.maxHp or 100
    local hpPct = clamp(hp / maxHp, 0, 1)
    local fillH = clamp(floor(h * hpPct), 0, h)

    e.isShown = true

    if S.bl_mob_box then
        place(e, "box", boxX, boxY)
        sizeIt(e, "box", w, h)
        setVis(e, "box", true)
    else
        setVis(e, "box", false)
    end

    if S.bl_mob_hp_b then
        local barX = boxX - 5
        place(e, "barBg", barX, boxY)
        sizeIt(e, "barBg", 3, h)
        place(e, "bar", barX, boxY + (h - fillH))
        sizeIt(e, "bar", 3, max(1, fillH))
        local col = (hpPct > 0.5 and COL_GREEN) or (hpPct > 0.25 and COL_YELLOW) or COL_RED
        if e.lastBarColor ~= col then
            e.bar.Color = col
            e.lastBarColor = col
        end
        setVis(e, "barBg", true)
        setVis(e, "bar", true)
    else
        setVis(e, "barBg", false)
        setVis(e, "bar", false)
    end

    local showName, showHpTxt, showDist = S.bl_mob_name, S.bl_mob_hp_t, S.bl_mob_dist
    if showName or showHpTxt or showDist then
        if e.owner ~= m then e.owner = m; e.textAt = 0 end
        if rNow - e.textAt >= TEXT_INTERVAL then
            e.textAt = rNow
            local label = showName and m.name or ""
            if showHpTxt then label = label .. " [" .. floor(hp) .. "/" .. floor(maxHp) .. "]" end
            if showDist then label = label .. " " .. floor(dist) .. "m" end
            if label ~= e.lastText then
                e.tag.Text = label
                e.lastText = label
            end
        end
        place(e, "tag", floor(sp.X), boxY - 16)
        setVis(e, "tag", true)
    else
        setVis(e, "tag", false)
    end
    return true
end

local function renderMobs()
    local count = 0
    if S.bl_mob_en then
        local list = drawMobs
        count = #list
        for i = 1, count do
            local e = mobPool[i]
            if not drawMobEntity(e, list[i]) then hideMobSlot(e) end
        end
    end
    for i = count + 1, MOB_POOL_SIZE do hideMobSlot(mobPool[i]) end
end

-- ---------------- CORRUPTION POINTS ----------------
local function drawCorruptEntity(e, c)
    local mod = c.model
    if mod then
        local okP, par = pcall(function() return mod.Parent end)
        if not okP or par ~= Workspace then return false end
    end
    if not c or not c.pos or not isValidVec3(c.pos) then return false end
    local pos = c.pos
    local dist = (rCamPos - pos).Magnitude
    if dist <= 0.5 then return false end

    local okS, sp, onScreen = pcall(WorldToScreen, pos)
    if not okS or not onScreen or not isValidVec2(sp) then return false end

    local rawH = (5.5 / (dist * rTan)) * rVpH
    if not isValidNum(rawH) then return false end

    local h = clamp(floor(rawH), 16, 450)
    local w = clamp(floor(h * 0.7), 10, 300)
    local boxX = floor(sp.X - floor(w * 0.5))
    local boxY = floor(sp.Y - floor(h * 0.5))

    e.isShown = true

    if S.bl_corrupt_box then
        place(e, "box", boxX, boxY)
        sizeIt(e, "box", w, h)
        local boxCol = c.isPumpkin and BX.RGB(255, 140, 0) or (S.bl_corrupt_col or COL_PURPLE)
        if e.boxColS ~= boxCol then e.box.Color = boxCol; e.boxColS = boxCol end
        setVis(e, "box", true)
    else
        setVis(e, "box", false)
    end

    local showName, showHp, showDist = S.bl_corrupt_name, S.bl_corrupt_hp, S.bl_corrupt_dist
    if showName or showHp or showDist then
        if e.owner ~= c then e.owner = c; e.textAt = 0 end
        if rNow - e.textAt >= TEXT_INTERVAL then
            e.textAt = rNow
            local pointName = c.name or (c.isPumpkin and "Pumpkin Point" or "Corrupted Point")
            local label = showName and pointName or ""
            if showHp then
                local curHp = nil
                if c.hpVal and c.hpVal.Parent then
                    pcall(function() curHp = c.hpVal.Value end)
                end
                if curHp == nil then curHp = c.hp end
                if curHp ~= nil then
                    local rawVal = math.clamp(floor(curHp), 0, 100)
                    local remainingHp = 100 - rawVal
                    if S.bl_corrupt_progress then
                        label = (label ~= "" and (label .. " ") or "") .. "[" .. rawVal .. "% Cleared]"
                    else
                        label = (label ~= "" and (label .. " ") or "") .. "[" .. remainingHp .. "/100 HP]"
                    end
                end
            end
            if showDist then
                label = (label ~= "" and (label .. " ") or "") .. "[" .. floor(dist) .. "m]"
            end
            if label ~= e.lastText then
                e.tag.Text = label
                e.lastText = label
            end
        end
        local tagCol = c.isPumpkin and BX.RGB(255, 200, 80) or COL_PURP_TXT
        if e.tagColS ~= tagCol then e.tag.Color = tagCol; e.tagColS = tagCol end
        place(e, "tag", floor(sp.X), boxY - 16)
        setVis(e, "tag", true)
    else
        setVis(e, "tag", false)
    end
    return true
end

local function renderCorrupt()
    local count = 0
    if S.bl_corrupt_en then
        local list = trackedCorrupt
        count = #list
        if count > CORRUPT_POOL_SIZE then count = CORRUPT_POOL_SIZE end
        for i = 1, count do
            local e = corruptPool[i]
            if not drawCorruptEntity(e, list[i]) then hideCorruptSlot(e) end
        end
    end
    for i = count + 1, CORRUPT_POOL_SIZE do hideCorruptSlot(corruptPool[i]) end
end

-- ---------------- EVENT RIFTS ----------------
local function drawRiftEntity(e, r)
    local inst = r.inst
    if inst then
        local okP, par = pcall(function() return inst.Parent end)
        if not okP or not par then return false end
    end
    if not r or not r.pos or not isValidVec3(r.pos) then return false end
    local pos = r.pos
    local dist = (rCamPos - pos).Magnitude
    if dist <= 0.5 then return false end

    local okS, sp, onScreen = pcall(WorldToScreen, pos)
    if not okS or not onScreen or not isValidVec2(sp) then return false end

    local rawH = (6.0 / (dist * rTan)) * rVpH
    if not isValidNum(rawH) then return false end

    local h = clamp(floor(rawH), 18, 450)
    local w = clamp(floor(h * 0.8), 12, 350)
    local boxX = floor(sp.X - floor(w * 0.5))
    local boxY = floor(sp.Y - floor(h * 0.5))

    e.isShown = true

    local riftCol = S.bl_rift_col or BX.RGB(255, 60, 20)
    local tagCol  = BX.RGB(255, 195, 60)

    if S.bl_rift_box then
        place(e, "box", boxX, boxY)
        sizeIt(e, "box", w, h)
        if e.riftBoxS ~= riftCol then e.box.Color = riftCol; e.riftBoxS = riftCol end
        setVis(e, "box", true)
    else
        setVis(e, "box", false)
    end

    local showName, showDist = S.bl_rift_name, S.bl_rift_dist
    if showName or showDist then
        if e.owner ~= r then e.owner = r; e.textAt = 0 end
