-- ---------------- ANIMATION TRACKER HUD + FLOATING TAG ----------------
local lastAnimData = nil
local animHudTargetStr, animHudContentStr, animTagStr = "", "", ""
local lastAnimTargetText, lastAnimContentText, lastAnimTagText = "", "", ""
local lastHudY = -1

local function rebuildAnimStrings(d)
    local lockStatus
    if d.isSelf then
        lockStatus = "[SELF]"
    elseif d.isLocked then
        lockStatus = "[LOCKED (Press T to Cycle)]"
    else
        lockStatus = "[NEAREST (Press T to Lock)]"
    end

    if d.isSelf then
        animHudTargetStr = string.format(" Target: %s [%.0f/%.0f HP] %s", d.name, d.hp, d.maxHp, lockStatus)
    else
        animHudTargetStr = string.format(" Target: %s [%.0f/%.0f HP] (%dm) %s", d.name, d.hp, d.maxHp, floor(d.dist), lockStatus)
    end

    local lines = {}
    if d.skill ~= "" or d.guard then
        lines[#lines + 1] = string.format(" Status: %s%s", (d.skill ~= "" and ("Skill: " .. d.skill .. " ") or ""), (d.guard and "[GUARDING]" or ""))
    end
    if #d.tracks > 0 then
        for idx, t in ipairs(d.tracks) do
            lines[#lines + 1] = string.format(" > Track %d: ID %s (Time: %.2fs)", idx, t.id, t.time)
        end
    else
        lines[#lines + 1] = " > Idle / Moving (No combat tracks)"
    end
    animHudContentStr = table.concat(lines, "\n")

    if #d.tracks > 0 then
        animTagStr = string.format("[Anim: %s (%.2fs)]", d.tracks[1].id, d.tracks[1].time)
    elseif d.skill ~= "" then
        animTagStr = string.format("[Skill: %s]", d.skill)
    else
        animTagStr = ""
    end
end

local function renderAnim(chakraShown)
    local d = animLiveData
    if not (S.bl_anim_en and d) then
        setHud(animHudTitle, false)
        setHud(animHudTarget, false)
        setHud(animHudContent, false)
        setHud(animTargetTag, false)
        lastAnimData = nil
        return
    end

    -- Strings are rebuilt only when the worker publishes new data (10x/s), not every frame
    if d ~= lastAnimData then
        lastAnimData = d
        rebuildAnimStrings(d)
        if S.bl_anim_hud then
            if animHudTargetStr ~= lastAnimTargetText then
                animHudTarget.Text = animHudTargetStr
                lastAnimTargetText = animHudTargetStr
            end
            if animHudContentStr ~= lastAnimContentText then
                animHudContent.Text = animHudContentStr
                lastAnimContentText = animHudContentStr
            end
        end
    end

    if S.bl_anim_hud then
        local hudY = chakraShown and 300 or 220
        if hudY ~= lastHudY then
            lastHudY = hudY
            animHudTitle.Position   = Vector2.new(16, hudY)
            animHudTarget.Position  = Vector2.new(16, hudY + 18)
            animHudContent.Position = Vector2.new(16, hudY + 36)
        end
        -- HUD may have just been switched on: make sure the texts are current
        if animHudTargetStr ~= lastAnimTargetText then
            animHudTarget.Text = animHudTargetStr
            lastAnimTargetText = animHudTargetStr
        end
        if animHudContentStr ~= lastAnimContentText then
            animHudContent.Text = animHudContentStr
            lastAnimContentText = animHudContentStr
        end
        setHud(animHudTitle, true)
        setHud(animHudTarget, true)
        setHud(animHudContent, true)
    else
        setHud(animHudTitle, false)
        setHud(animHudTarget, false)
        setHud(animHudContent, false)
    end

    local tagShown = false
    if S.bl_anim_tag and d.root and animTagStr ~= "" then
        local okP, rPos = pcall(getPosOf, d.root)
        if okP and isValidVec3(rPos) then
            local okS, sp, onScreen = pcall(WorldToScreen, rPos)
            if okS and onScreen and isValidVec2(sp) then
                local dist = (rCamPos - rPos).Magnitude
                local rawH = (5.5 / (dist * rTan)) * rVpH
                if isValidNum(rawH) then
                    local h = clamp(floor(rawH), 16, 450)
                    if animTagStr ~= lastAnimTagText then
                        animTargetTag.Text = animTagStr
                        lastAnimTagText = animTagStr
                    end
                    animTargetTag.Position = Vector2.new(floor(sp.X), floor(sp.Y - floor(h * 0.5) - 32))
                    setHud(animTargetTag, true)
                    tagShown = true
                end
            end
        end
    end
    if not tagShown then setHud(animTargetTag, false) end
end

-- ---------------- HIDE EVERYTHING (camera lost / render error) ----------------
local function hideAllDrawings()
    for i = 1, MOB_POOL_SIZE do local s = mobPool[i]; s.isShown = true; hideMobSlot(s) end
    for i = 1, CORRUPT_POOL_SIZE do local s = corruptPool[i]; s.isShown = true; hideCorruptSlot(s) end
    for i = 1, NPC_POOL_SIZE do local s = npcPool[i]; s.isShown = true; hideNPCSlot(s) end
    for i = 1, ITEM_POOL_SIZE do local s = itemPool[i]; s.isShown = true; hideItemSlot(s) end
    setHud(csHudTitle, false)
    setHud(csHudContent, false)
    setHud(animHudTitle, false)
    setHud(animHudTarget, false)
    setHud(animHudContent, false)
    setHud(animTargetTag, false)
    hideEventSlot()
    lastAnimData = nil
end

local function renderFrame()
    local cam = Workspace.CurrentCamera
    local camPos = cam and cam.Position
    local viewport = cam and cam.ViewportSize

    -- No usable camera (loading screen / respawn / minimized): clear the screen instead of
    -- leaving the last frame's boxes frozen on it.
    if not (camPos and isValidVec3(camPos) and viewport and viewport.X > 20 and viewport.Y > 20) then
        hideAllDrawings()
        return
    end

    local tanHalfFov2 = math.tan(math.rad(cam.FieldOfView or 70) * 0.5) * 2.0
    if not isValidNum(tanHalfFov2) or tanHalfFov2 <= 0.001 then
        hideAllDrawings()
        return
    end

    rCamPos = camPos
    rVpH    = viewport.Y
    rTan    = tanHalfFov2
    rBotX   = floor(viewport.X * 0.5)
    rBotY   = floor(viewport.Y)

    -- Fast-travel flush (>100 studs in one frame)
    if lastCamPos and (camPos - lastCamPos).Magnitude > 100.0 then
        scanEpoch = scanEpoch + 1
        trackedMobs, trackedCorrupt, trackedNPCs, trackedItems = {}, {}, {}, {}
        drawDirty = true
    end
    lastCamPos = camPos

    if drawDirty or lastDrawSettingsVersion ~= settingsVersion then
        rebuildDrawLists()
    end

    renderMobs()
    renderCorrupt()
    renderNPCs()
    renderItems()
    local chakraShown = renderChakraHud()
    renderBeastTamer()
    renderAnim(chakraShown)
end

_G.Bloodline_renderConn = RunService.RenderStepped:Connect(function()
    if not alive() then return end

    -- Frame limiter. The old check was `dt < 1/60`, which at a real 60 Hz skipped roughly every
    -- other frame (dt is often 16.5 ms < 16.67 ms) => the ESP updated at ~30 FPS and looked choppy.
    -- Now: 15% tolerance and a higher cap, so it follows your display refresh rate.
    local now = os.clock()
    if (now - lastRenderClock) < MIN_FRAME_TIME then return end
    lastRenderClock = now
    rNow = now

    _G.Bloodline_renderFrameCount = _G.Bloodline_renderFrameCount + 1

    if now - lastSettingsPoll >= SETTINGS_POLL then
        lastSettingsPoll = now
        pcall(refreshSettings)
    end

    local ok, err = pcall(renderFrame)
    if not ok then
        _G.Bloodline_lastError = tostring(err)
        logDebug("RenderStepped error: " .. tostring(err))
        pcall(hideAllDrawings)
    end
end)

