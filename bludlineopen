local function splitItemsIntoLines(items, maxPerLine, maxChars)
    local lines = {}
    local cur = {}
    local curLen = 0
    for _, it in ipairs(items) do
        local itLen = #it + 4
        if #cur >= maxPerLine or (curLen + itLen > maxChars and #cur > 0) then
            table.insert(lines, table.concat(cur, "  "))
            cur = {}
            curLen = 0
        end
        table.insert(cur, "• " .. it)
        curLen = curLen + itLen
    end
    if #cur > 0 then
        table.insert(lines, table.concat(cur, "  "))
    end
    return lines
end

local function fetchPlayerDetails(p)
    local pName = p.Name
    local rs = game:GetService("ReplicatedStorage")
    local s = rs:FindFirstChild("Settings") and rs.Settings:FindFirstChild(pName)
    local cd = rs:FindFirstChild("Cooldowns") and rs.Cooldowns:FindFirstChild(pName)

    -- Clan / Bloodline
    local clan = "Unknown"
    local blVal = s and s:FindFirstChild("Bloodline")
    if blVal and blVal.Value and blVal.Value ~= "" then
        clan = blVal.Value
    elseif p.Character then
        local knownClans = {"Ayrui", "Gaara", "Uchiha", "Hoshigaki", "Uzumaki", "Senju", "Zetsu", "Hyuga", "Nara", "Inuzuka"}
        local attrs = p.Character:GetAttributes()
        for _, cl in ipairs(knownClans) do
            if attrs[cl] ~= nil then clan = cl; break end
        end
    end

    -- HP & Max HP
    local curHp, maxHp = 0, 100
    local hum = p.Character and p.Character:FindFirstChild("Humanoid")
    if hum then
        local okH, h = pcall(function() return hum.Health end)
        local okM, m = pcall(function() return hum.MaxHealth end)
        if okH and type(h) == "number" then curHp = math.floor(h) end
        if okM and type(m) == "number" then maxHp = math.floor(m) end
    end

    -- Weapon
    local weapon = "Fist"
    local wpVal = s and s:FindFirstChild("CurrentWeapon")
    if wpVal and wpVal.Value and wpVal.Value ~= "" then
        weapon = wpVal.Value
    end

    -- Armor / Clothing
    local armor = "None"
    local clVal = s and s:FindFirstChild("Clothing")
    if clVal and clVal.Value and clVal.Value ~= "" then
        armor = clVal.Value
    end

    -- Mode / Awakening
    local mode = "None"
    local awkVal = s and s:FindFirstChild("Awakened")
    if awkVal and awkVal.Value and awkVal.Value ~= "" then
        mode = awkVal.Value
    end

    -- Rings
    local rings = {}
    local r1 = s and s:FindFirstChild("Ring1")
    local r2 = s and s:FindFirstChild("Ring2")
    if r1 and r1.Value and r1.Value ~= "" then table.insert(rings, r1.Value) end
    if r2 and r2.Value and r2.Value ~= "" then table.insert(rings, r2.Value) end
    local ringsStr = #rings > 0 and table.concat(rings, ", ") or "None"

    -- Traits & Eyes
    local traits = {}
    if p.Character and p.Character:FindFirstChild("Traits") then
        for _, t in ipairs(p.Character.Traits:GetChildren()) do
            table.insert(traits, t.Name)
        end
    end
    local traitsStr = #traits > 0 and table.concat(traits, ", ") or "None"

    -- Skills
    local skills = {}
    if cd then
        for _, sk in ipairs(cd:GetChildren()) do
            table.insert(skills, sk.Name)
        end
    end
    table.sort(skills)

    return {
        name = pName,
        clan = clan,
        curHp = curHp,
        maxHp = maxHp,
        weapon = weapon,
        armor = armor,
        mode = mode,
        rings = ringsStr,
        traits = traitsStr,
        traitsList = traits,
        skills = skills,
    }
end

