local function refreshSettings()
    local changed = false
    for i = 1, #SETTING_DEFAULTS do
        local d = SETTING_DEFAULTS[i]
        local v = getUI(d[1], d[2])
        if S[d[1]] ~= v then
            S[d[1]] = v
            changed = true
        end
    end
    if changed then settingsVersion = settingsVersion + 1 end
    return changed
end
