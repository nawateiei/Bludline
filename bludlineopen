local function isAliveHum(h)
    local ok, hp = pcall(getHealth, h)
    return ok and isValidNum(hp) and hp > 0
end

local function serverNow()
    local ok, t = pcall(getServerNow)
    if ok and type(t) == "number" then return t end
    return os.time()
end

local function byDist(a, b) return a.dist < b.dist end
local function itemLess(a, b)
    if a.isRare ~= b.isRare then return a.isRare end
    return a.dist < b.dist
end
local function capList(list, n)
    for i = #list, n + 1, -1 do list[i] = nil end
end

-- ============================================================
--  JUTSU DETECTOR (own thread, TIME-SLICED + BUDGETED)
--
--  Why the old one lagged: one tick did hundreds of .Value reads in a single frame
--  (every cooldown of every nearby player), which showed up as a frame spike.
--
--  Now:
--   * HARD per-frame budget (FRAME_BUDGET). When the detector has used its slice it calls
--     task.wait() and continues next frame, so it can never stall a frame.
--   * CurrentSkill (1 read per player) is the cheap main source, checked every cycle.
--   * Cooldown scanning (many reads per player) is optional (toggle "Cooldown Scan"), only for the
--     CD_PLAYERS_MAX nearest players, and ROUND-ROBIN: CD_PER_CYCLE players per cycle.
--   * Mobs/bosses: 5 nearest, every 3rd cycle.
--   * Players are pre-sorted by distance twice a second, so no sorting per cycle.
--   * Sleeps when the toggle is off or nobody is around.
-- ============================================================
