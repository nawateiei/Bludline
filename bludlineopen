-- Shadow visibility flags: we never READ .Visible from a Drawing (every property read crosses
-- the engine bridge); we remember what we last wrote and only write on change.
local function setVis(s, key, want)
    local vis = s.vis
    if vis[key] ~= want then
        s[key].Visible = want
        vis[key] = want
    end
end

