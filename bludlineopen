-- IEEE-754 Validation Helpers
local function isValidNum(n)
    return type(n) == "number" and n == n and n > -1e9 and n < 1e9
end

local function isValidVec2(v)
    return v and isValidNum(v.X) and isValidNum(v.Y)
end

local function isValidVec3(v)
    return v and isValidNum(v.X) and isValidNum(v.Y) and isValidNum(v.Z)
end

